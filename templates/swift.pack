=== sorting-visualizer | Sorting Visualizer | Algorithms | chart.bar.xaxis | Watch bubble, insertion and quick sort work, and count their steps.
--- main.swift
import Foundation

func show(_ values: [Int], _ note: String = "") {
    print(values.map { String(format: "%2d", $0) }.joined(separator: " ") + "   " + note)
}

func bubble(_ input: [Int]) -> Int {
    var a = input, steps = 0
    for end in stride(from: a.count - 1, to: 0, by: -1) {
        for i in 0..<end {
            steps += 1
            if a[i] > a[i + 1] { a.swapAt(i, i + 1) }
        }
        show(a, "largest \(a[end]) bubbled to the end")
    }
    return steps
}

func insertion(_ input: [Int]) -> Int {
    var a = input, steps = 0
    for i in 1..<a.count {
        let item = a[i]
        var j = i - 1
        while j >= 0 && a[j] > item {
            a[j + 1] = a[j]
            j -= 1
            steps += 1
        }
        a[j + 1] = item
        show(a, "inserted \(item)")
    }
    return steps
}

func quick(_ input: [Int]) -> Int {
    var steps = 0
    func sort(_ a: [Int]) -> [Int] {
        guard let pivot = a.first else { return [] }
        let rest = a.dropFirst()
        steps += rest.count
        return sort(rest.filter { $0 < pivot }) + [pivot] + sort(rest.filter { $0 >= pivot })
    }
    show(sort(input), "sorted by splitting around pivots")
    return steps
}

let values = (0..<8).map { _ in Int.random(in: 1...40) }
let sorts: [(String, ([Int]) -> Int)] = [("Bubble sort", bubble), ("Insertion sort", insertion), ("Quicksort", quick)]
for (name, sort) in sorts {
    print("\n\(name)")
    show(values, "start")
    print("  \(sort(values)) comparisons")
}

=== binary-search | Binary Search | Algorithms | magnifyingglass.circle.fill | Find a value in a sorted list by halving the search each step.
--- main.swift
import Foundation
setvbuf(stdout, nil, _IONBF, 0)

/// Works on any sorted array of comparable things.
func binarySearch<T: Comparable>(_ items: [T], for target: T) -> (index: Int?, steps: Int) {
    var low = 0, high = items.count - 1, steps = 0
    while low <= high {
        let mid = (low + high) / 2
        steps += 1
        print("  step \(steps): position \(mid) holds \(items[mid]) (searching \(low)–\(high))")
        if items[mid] == target { return (mid, steps) }
        if items[mid] < target { low = mid + 1 } else { high = mid - 1 }
    }
    return (nil, steps)
}

let items = (1...99).map { $0 * 3 }   // 3, 6, 9 … 297
print("Number to find in \(items.count) sorted numbers [201]: ", terminator: "")
let target = Int(readLine() ?? "") ?? 201
let result = binarySearch(items, for: target)
print(result.index.map { "Found at position \($0)." } ?? "Not in the list.")
print("Binary search took \(result.steps) steps; checking one by one could take \(items.count).")

print("\nIt works for words too:")
_ = binarySearch(["apple", "banana", "cherry", "grape", "mango", "peach"], for: "mango")

=== fibonacci | Fibonacci Three Ways | Algorithms | function | Slow recursion, memoization and a lazy sequence, timed against each other.
--- main.swift
import Foundation

func fibSlow(_ n: Int) -> Int { n < 2 ? n : fibSlow(n - 1) + fibSlow(n - 2) }

var cache: [Int: Int] = [:]
func fibFast(_ n: Int) -> Int {
    if n < 2 { return n }
    if let known = cache[n] { return known }
    let value = fibFast(n - 1) + fibFast(n - 2)
    cache[n] = value
    return value
}

/// An endless sequence: values are only worked out when asked for.
struct Fibonacci: Sequence, IteratorProtocol {
    var a = 0, b = 1
    mutating func next() -> Int? {
        defer { (a, b) = (b, a &+ b) }
        return a
    }
}

func timed(_ label: String, _ n: Int, _ fn: (Int) -> Int) {
    let start = Date()
    let result = fn(n)
    let ms = Date().timeIntervalSince(start) * 1000
    print("fib(\(n)) = \(result)  \(label)  " + String(format: "%.3f ms", ms))
}

timed("plain recursion", 27, fibSlow)
timed("with a cache   ", 27, fibFast)
print("First 15: \(Array(Fibonacci().prefix(15)))")
print("fib(90) with the cache: \(fibFast(90))")
print("First over a million: \(Fibonacci().first { $0 > 1_000_000 } ?? 0)")

=== prime-sieve | Prime Numbers | Algorithms | number.square.fill | Find every prime up to a limit, and split numbers into prime factors.
--- main.swift
import Foundation
setvbuf(stdout, nil, _IONBF, 0)

func sieve(upTo limit: Int) -> [Int] {
    guard limit >= 2 else { return [] }
    var isPrime = [Bool](repeating: true, count: limit + 1)
    isPrime[0] = false
    isPrime[1] = false
    var n = 2
    while n * n <= limit {
        if isPrime[n] {
            for multiple in stride(from: n * n, through: limit, by: n) { isPrime[multiple] = false }
        }
        n += 1
    }
    return isPrime.indices.filter { isPrime[$0] }
}

func factors(of number: Int) -> [Int] {
    var n = number, d = 2, out: [Int] = []
    while d * d <= n {
        while n % d == 0 {
            out.append(d)
            n /= d
        }
        d += 1
    }
    if n > 1 { out.append(n) }
    return out
}

print("Find primes up to [100]: ", terminator: "")
let limit = min(max(Int(readLine() ?? "") ?? 100, 2), 1_000_000)
let primes = sieve(upTo: limit)
print("\(primes.count) primes up to \(limit):")
print(primes.count <= 60 ? "\(primes)" : "\(Array(primes.prefix(30))) … \(Array(primes.suffix(5)))")
for n in [limit, 360, 97, 1001] {
    print("\(n) = " + factors(of: n).map(String.init).joined(separator: " × "))
}

=== maze-solver | Maze Solver | Algorithms | arrow.triangle.turn.up.right.diamond.fill | Find the shortest way through a maze with breadth-first search.
--- main.swift
// Edit the maze: # is a wall, S the start, E the end.
import Foundation

let maze = """
##########
#S   #   #
# ## # # #
# #    # #
# #### # #
#    #   #
#### # ###
#      E #
##########
""".split(separator: "\n").map { Array($0) }

struct Point: Hashable {
    let row: Int
    let col: Int
}

func find(_ char: Character) -> Point? {
    for (r, row) in maze.enumerated() {
        if let c = row.firstIndex(of: char) { return Point(row: r, col: c) }
    }
    return nil
}

func solve() -> [Point]? {
    guard let start = find("S"), let end = find("E") else { return nil }
    var cameFrom: [Point: Point] = [:]
    var seen: Set<Point> = [start]
    var queue = [start]
    var head = 0
    while head < queue.count {
        let here = queue[head]
        head += 1
        if here == end {
            var path = [end]
            while let previous = cameFrom[path[0]] { path.insert(previous, at: 0) }
            return path
        }
        for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
            let next = Point(row: here.row + dr, col: here.col + dc)
            if maze[next.row][next.col] != "#" && !seen.contains(next) {
                seen.insert(next)
                cameFrom[next] = here
                queue.append(next)
            }
        }
    }
    return nil
}

if let path = solve() {
    let steps = Set(path.dropFirst().dropLast())
    for (r, row) in maze.enumerated() {
        print(String(row.enumerated().map { c, ch in steps.contains(Point(row: r, col: c)) ? "•" : ch }))
    }
    print("\nShortest path: \(path.count - 1) steps")
} else {
    print("No way through!")
}

=== n-queens | N-Queens Puzzle | Algorithms | crown.fill | Place queens so none can attack another, using backtracking.
--- main.swift
import Foundation
setvbuf(stdout, nil, _IONBF, 0)

func solve(_ n: Int) -> [[Int]] {
    var solutions: [[Int]] = []
    var cols: [Int] = []

    func safe(_ row: Int, _ col: Int) -> Bool {
        for (r, c) in cols.enumerated() where c == col || abs(c - col) == row - r { return false }
        return true
    }

    func place(_ row: Int) {
        if row == n {
            solutions.append(cols)
            return
        }
        for col in 0..<n where safe(row, col) {
            cols.append(col)
            place(row + 1)
            cols.removeLast()
        }
    }

    place(0)
    return solutions
}

print("Board size 4-9 [6]: ", terminator: "")
let typed = Int(readLine() ?? "") ?? 6
let n = (4...9).contains(typed) ? typed : 6
let solutions = solve(n)
print("\(solutions.count) ways to place \(n) queens. The first:\n")
for col in solutions[0] {
    print((0..<n).map { $0 == col ? "♛" : "·" }.joined(separator: " "))
}
print("\nSolutions by board size: " + (4...8).map { "\($0)→\(solve($0).count)" }.joined(separator: "  "))

=== sudoku-solver | Sudoku Solver | Algorithms | square.grid.3x3.topleft.filled | Solve any sudoku with backtracking. Edit the puzzle and run again.
--- main.swift
// 0 means an empty square.
import Foundation

let puzzle = [
    "530070000", "600195000", "098000060",
    "800060003", "400803001", "700020006",
    "060000280", "000419005", "000080079",
]

var grid = puzzle.map { $0.map { Int(String($0))! } }
var tries = 0

func options(_ r: Int, _ c: Int) -> [Int] {
    var used = Set(grid[r])
    for i in 0..<9 { used.insert(grid[i][c]) }
    let br = r / 3 * 3, bc = c / 3 * 3
    for i in 0..<3 { for j in 0..<3 { used.insert(grid[br + i][bc + j]) } }
    return (1...9).filter { !used.contains($0) }
}

func solve() -> Bool {
    for r in 0..<9 {
        for c in 0..<9 where grid[r][c] == 0 {
            for digit in options(r, c) {
                tries += 1
                grid[r][c] = digit
                if solve() { return true }
                grid[r][c] = 0
            }
            return false
        }
    }
    return true
}

func draw() {
    for (r, row) in grid.enumerated() {
        if r % 3 == 0 && r > 0 { print("------+-------+------") }
        let groups = stride(from: 0, to: 9, by: 3).map { i in
            row[i..<i + 3].map { $0 == 0 ? "·" : String($0) }.joined(separator: " ")
        }
        print(groups.joined(separator: " | "))
    }
}

draw()
if solve() {
    print("\nSolved after trying \(tries) digits:\n")
    draw()
} else {
    print("\nThis puzzle has no solution.")
}

=== game-of-life | Game of Life | Algorithms | circle.grid.cross.fill | Conway's cell simulation: three simple rules make gliders and blinkers.
--- main.swift
// A live cell survives with 2 or 3 neighbours; an empty cell with exactly 3 comes alive.
import Foundation

struct Cell: Hashable {
    let x: Int
    let y: Int
}

let width = 24, height = 10

func step(_ alive: Set<Cell>) -> Set<Cell> {
    var counts: [Cell: Int] = [:]
    for cell in alive {
        for dx in -1...1 {
            for dy in -1...1 where dx != 0 || dy != 0 {
                let neighbour = Cell(x: (cell.x + dx + width) % width, y: (cell.y + dy + height) % height)
                counts[neighbour, default: 0] += 1
            }
        }
    }
    return Set(counts.filter { $0.value == 3 || ($0.value == 2 && alive.contains($0.key)) }.keys)
}

func draw(_ alive: Set<Cell>, generation: Int) {
    print("Generation \(generation) (\(alive.count) cells)")
    for y in 0..<height {
        print(String((0..<width).map { alive.contains(Cell(x: $0, y: y)) ? Character("█") : Character("·") }))
    }
    print("")
}

let glider = [(1, 0), (2, 1), (0, 2), (1, 2), (2, 2)]
let blinker = [(12, 4), (13, 4), (14, 4)]
var alive = Set((glider + blinker).map { Cell(x: $0.0, y: $0.1) })
for generation in 0..<6 {
    draw(alive, generation: generation)
    alive = step(alive)
}

=== tower-of-hanoi | Tower of Hanoi | Algorithms | square.stack.3d.up.fill | Move a stack of discs between pegs with a short recursive rule.
--- main.swift
import Foundation
setvbuf(stdout, nil, _IONBF, 0)

print("Discs 1-5 [3]: ", terminator: "")
let typed = Int(readLine() ?? "") ?? 3
let discs = (1...5).contains(typed) ? typed : 3
var pegs: [[Int]] = [Array((1...discs).reversed()), [], []]
var moves = 0
let names = ["A", "B", "C"]

func center(_ s: String) -> String {
    let pad = discs * 2 + 1 - s.count
    return String(repeating: " ", count: pad / 2) + s + String(repeating: " ", count: pad - pad / 2)
}

func draw() {
    for level in stride(from: discs - 1, through: 0, by: -1) {
        print(pegs.map { peg in
            center(level < peg.count ? String(repeating: "█", count: peg[level] * 2 - 1) : "|")
        }.joined())
    }
    print(names.map(center).joined() + "\n")
}

func hanoi(_ n: Int, from: Int, to: Int, spare: Int) {
    if n == 0 { return }
    hanoi(n - 1, from: from, to: spare, spare: to)
    pegs[to].append(pegs[from].removeLast())
    moves += 1
    print("Move \(moves): \(names[from]) → \(names[to])")
    draw()
    hanoi(n - 1, from: spare, to: to, spare: from)
}

draw()
hanoi(discs, from: 0, to: 2, spare: 1)
print("Solved in \(moves) moves (the minimum is 2^\(discs) - 1 = \((1 << discs) - 1)).")

=== optionals | Optionals | Learn Swift | questionmark.diamond.fill | Swift's way of saying "there might be no value", and every way to unwrap one.
--- main.swift
// An optional either holds a value or is nil. Swift makes you deal with the nil case.
import Foundation

let ages = ["Ada": 36, "Linus": 28]
let known: Int? = ages["Ada"]        // looking something up might find nothing
let unknown: Int? = ages["Nobody"]
print("known: \(String(describing: known)), unknown: \(String(describing: unknown))")

// 1. if let: use the value only if it's there.
if let age = known { print("if let: Ada is \(age)") }
if let age = unknown { print(age) } else { print("if let: no age for Nobody") }

// 2. guard let: leave early when it's missing.
func describe(_ name: String) -> String {
    guard let age = ages[name] else { return "\(name): unknown" }
    return "\(name): \(age) years old"
}
print("guard: \(describe("Linus")) | \(describe("Grace"))")

// 3. ?? gives a default.
print("default: \(unknown ?? 0)")

// 4. Optional chaining: stop at the first nil instead of crashing.
struct Address { var city: String }
struct Person { var name: String; var address: Address? }
let people = [Person(name: "Ada", address: Address(city: "London")), Person(name: "Bob", address: nil)]
for p in people { print("chaining: \(p.name) lives in \(p.address?.city.uppercased() ?? "an unknown place")") }

// 5. map transforms the value if there is one.
let doubled = known.map { $0 * 2 }
print("map: \(doubled ?? -1)")

// 6. Converting text can fail, so it returns an optional.
for text in ["42", "forty-two"] {
    if let number = Int(text) { print("Int(\"\(text)\") = \(number)") } else { print("Int(\"\(text)\") is nil") }
}

// 7. compactMap drops the nils.
print("compactMap: \(["1", "two", "3", "four"].compactMap { Int($0) })")

// Force-unwrapping with ! crashes on nil. Only use it when nil is truly impossible.
print("force unwrap (safe here): \(known!)")

=== structs-classes | Structs vs Classes | Learn Swift | square.on.square | Value types get copied, reference types get shared. See the difference.
--- main.swift
import Foundation

struct PointStruct {
    var x: Int
    var y: Int

    // A method that changes a struct must say so.
    mutating func move(dx: Int, dy: Int) {
        x += dx
        y += dy
    }
}

final class PointClass {
    var x: Int
    var y: Int
    init(x: Int, y: Int) {
        self.x = x
        self.y = y
    }
}

// Structs are copied: changing the copy leaves the original alone.
var a = PointStruct(x: 1, y: 1)
var b = a
b.move(dx: 10, dy: 0)
print("struct: a.x = \(a.x), b.x = \(b.x)   (independent copies)")

// Classes are shared: both names point at the same object.
let c = PointClass(x: 1, y: 1)
let d = c
d.x += 10
print("class:  c.x = \(c.x), d.x = \(d.x)  (same object)")
print("same object? \(c === d)")

// Structs get a free initializer and work well with protocols.
struct Player: Equatable, CustomStringConvertible {
    var name: String
    var score = 0
    var description: String { "\(name) (\(score))" }
}
var team = [Player(name: "Ada"), Player(name: "Bob", score: 5)]
team[0].score += 3
print("players: \(team), equal? \(team[0] == Player(name: "Ada", score: 3))")

// Classes can inherit, and can clean up when they go away.
class Animal {
    let name: String
    init(name: String) { self.name = name }
    func speak() -> String { "..." }
    deinit { print("  (\(name) was freed)") }
}
class Dog: Animal {
    override func speak() -> String { "Woof" }
}
do {
    let pet: Animal = Dog(name: "Rex")
    print("\(pet.name) says \(pet.speak())")
}
print("Rule of thumb: start with a struct; use a class when things must be shared.")

=== enums | Enums & Pattern Matching | Learn Swift | list.bullet.indent | Enums with attached data, switch statements, and a tiny expression calculator.
--- main.swift
import Foundation

// A simple enum with raw values.
enum Planet: Int, CaseIterable {
    case mercury = 1, venus, earth, mars
    var name: String { String(describing: self).capitalized }
}
print(Planet.allCases.map { "\($0.rawValue). \($0.name)" }.joined(separator: "  "))
print("Planet 3 is \(Planet(rawValue: 3)?.name ?? "unknown"); planet 9 is \(Planet(rawValue: 9)?.name ?? "unknown")")

// Cases can carry different data.
enum Shape {
    case circle(radius: Double)
    case rectangle(width: Double, height: Double)
    case triangle(base: Double, height: Double)

    var area: Double {
        switch self {
        case .circle(let r): return Double.pi * r * r
        case .rectangle(let w, let h): return w * h
        case .triangle(let b, let h): return b * h / 2
        }
    }
}
let shapes: [Shape] = [.circle(radius: 1), .rectangle(width: 3, height: 4), .triangle(base: 6, height: 2)]
for s in shapes { print("\(s) has area " + String(format: "%.2f", s.area)) }

// switch can match ranges, tuples and conditions.
func grade(_ score: Int) -> String {
    switch score {
    case 90...100: return "A"
    case 80..<90: return "B"
    case 70..<80: return "C"
    case let s where s < 0 || s > 100: return "invalid"
    default: return "F"
    }
}
print([95, 83, 71, 40, 120].map { "\($0)→\(grade($0))" }.joined(separator: "  "))

// A result that is either a value or an error message.
enum Download {
    case success(bytes: Int)
    case failure(reason: String)
}
for result in [Download.success(bytes: 2048), .failure(reason: "no connection")] {
    if case .success(let bytes) = result { print("Got \(bytes) bytes") } else { print("Failed: \(result)") }
}

// indirect lets an enum contain itself: here, a tree for sums.
indirect enum Expr {
    case number(Double)
    case add(Expr, Expr)
    case multiply(Expr, Expr)

    func evaluate() -> Double {
        switch self {
        case .number(let n): return n
        case .add(let a, let b): return a.evaluate() + b.evaluate()
        case .multiply(let a, let b): return a.evaluate() * b.evaluate()
        }
    }
}
let sum = Expr.add(.number(2), .multiply(.number(3), .number(4)))
print("2 + 3 × 4 = \(sum.evaluate())")

=== protocols | Protocols & Extensions | Learn Swift | puzzlepiece.fill | Describe what types can do, then add features to any type, even built-in ones.
--- main.swift
import Foundation

// A protocol is a list of requirements.
protocol Describable {
    var summary: String { get }
}

protocol Priced {
    var price: Double { get }
}

// An extension can give every conforming type free behaviour.
extension Priced {
    var priceWithTax: Double { price * 1.08 }
    var label: String { String(format: "$%.2f", priceWithTax) }
}

struct Book: Describable, Priced {
    let title: String
    let price: Double
    var summary: String { "Book: \(title)" }
}

struct Coffee: Describable, Priced {
    let size: String
    var price: Double { size == "large" ? 4.5 : 3.0 }
    var summary: String { "\(size.capitalized) coffee" }
}

// One array, different types, same protocol.
let cart: [Describable & Priced] = [Book(title: "Dune", price: 12), Coffee(size: "large"), Coffee(size: "small")]
for item in cart { print("\(item.summary) — \(item.label)") }
print("Total with tax: " + String(format: "$%.2f", cart.reduce(0) { $0 + $1.priceWithTax }))

// Extensions add to types you didn't write.
extension Int {
    var isEven: Bool { self % 2 == 0 }
    func times(_ action: () -> Void) { for _ in 0..<self { action() } }
}
extension String {
    var isPalindrome: Bool {
        let letters = lowercased().filter { $0.isLetter }
        return letters == String(letters.reversed())
    }
}
print("4.isEven: \(4.isEven), \"Racecar\".isPalindrome: \("Racecar".isPalindrome)")
3.times { print("hip", terminator: " ") }
print("hooray!")

// Extend only some collections: here, arrays of numbers.
extension Array where Element: Numeric {
    var total: Element { reduce(0, +) }
}
print("[1, 2, 3].total = \([1, 2, 3].total), [1.5, 2.5].total = \([1.5, 2.5].total)")

// Conforming to built-in protocols gives you sorting and printing.
struct Version: Comparable, CustomStringConvertible {
    let major: Int
    let minor: Int
    var description: String { "\(major).\(minor)" }
    static func < (a: Version, b: Version) -> Bool { (a.major, a.minor) < (b.major, b.minor) }
}
let versions = [Version(major: 2, minor: 1), Version(major: 1, minor: 9), Version(major: 2, minor: 0)]
print("sorted: \(versions.sorted()), newest: \(versions.max()!)")

=== generics | Generics | Learn Swift | arrow.triangle.swap | Write one function or type that works for many kinds of data.
--- main.swift
import Foundation

// One function for every type that can be compared.
func largest<T: Comparable>(_ items: [T]) -> T? {
    guard var best = items.first else { return nil }
    for item in items where item > best { best = item }
    return best
}
print(largest([3, 9, 4]) ?? 0, largest(["pear", "apple", "zebra"]) ?? "", largest([2.5, 1.5]) ?? 0)

// A generic type: a stack of anything.
struct Stack<Element> {
    private var items: [Element] = []
    var isEmpty: Bool { items.isEmpty }
    var count: Int { items.count }
    var top: Element? { items.last }
    mutating func push(_ item: Element) { items.append(item) }
    mutating func pop() -> Element? { items.popLast() }
}

var numbers = Stack<Int>()
for n in 1...3 { numbers.push(n) }
print("popped \(numbers.pop() ?? 0), top is now \(numbers.top ?? 0), \(numbers.count) left")

// Using the stack: check that brackets are balanced.
func isBalanced(_ text: String) -> Bool {
    let pairs: [Character: Character] = [")": "(", "]": "[", "}": "{"]
    var stack = Stack<Character>()
    for ch in text {
        if pairs.values.contains(ch) {
            stack.push(ch)
        } else if let opener = pairs[ch] {
            if stack.pop() != opener { return false }
        }
    }
    return stack.isEmpty
}
for sample in ["{[()]}", "([)]", "((("] { print("\(sample) balanced? \(isBalanced(sample))") }

// Extra abilities only when the element allows it.
extension Stack where Element: Equatable {
    func contains(_ item: Element) -> Bool { items.contains(item) }
}
print("stack contains 1? \(numbers.contains(1))")

// Two type parameters, and a constraint written with where.
func pairs<A, B>(_ first: [A], _ second: [B]) -> [(A, B)] { Array(zip(first, second)) }
print(pairs(["a", "b"], [1, 2]))

func countMatches<S: Sequence>(in items: S, where test: (S.Element) -> Bool) -> Int {
    var n = 0
    for item in items where test(item) { n += 1 }
    return n
}
print("evens in 1...10: \(countMatches(in: 1...10) { $0 % 2 == 0 }), vowels in \"mango\": \(countMatches(in: "mango") { "aeiou".contains($0) })")

// A small generic cache.
struct Cache<Key: Hashable, Value> {
    private var storage: [Key: Value] = [:]
    mutating func value(for key: Key, orCompute make: () -> Value) -> Value {
        if let hit = storage[key] { return hit }
        let made = make()
        storage[key] = made
        return made
    }
}
var squares = Cache<Int, Int>()
var computed = 0
for n in [4, 4, 4, 5] { _ = squares.value(for: n) { computed += 1; return n * n } }
print("4 lookups, \(computed) real calculations")

=== closures | Closures | Learn Swift | curlybraces | Functions you can store and pass around: sorting, callbacks and capturing values.
--- main.swift
import Foundation

// A closure is a function without a name. These four lines mean the same thing.
let double1 = { (n: Int) -> Int in return n * 2 }
let double2: (Int) -> Int = { n in n * 2 }
let double3: (Int) -> Int = { $0 * 2 }
func double4(_ n: Int) -> Int { n * 2 }
print(double1(21), double2(21), double3(21), double4(21))

// Passing closures to functions.
let names = ["Linus", "ada", "Grace", "alan"]
print("sorted, ignoring case: \(names.sorted { $0.lowercased() < $1.lowercased() })")
print("longest first:         \(names.sorted { $0.count > $1.count })")

// Your own function that takes a closure.
func repeatTask(_ times: Int, _ task: (Int) -> Void) {
    for i in 1...times { task(i) }
}
repeatTask(3) { print("  step \($0)") }

// Closures capture the variables around them.
func makeCounter(start: Int = 0) -> () -> Int {
    var count = start
    return {
        count += 1
        return count
    }
}
let countA = makeCounter(), countB = makeCounter(start: 100)
print("counters: \(countA()), \(countA()), \(countB()), \(countA())")

// Returning functions: build new behaviour from pieces.
func multiplier(_ factor: Int) -> (Int) -> Int { { $0 * factor } }
let triple = multiplier(3)
print("triple(14) = \(triple(14))")

func compose<A, B, C>(_ f: @escaping (A) -> B, _ g: @escaping (B) -> C) -> (A) -> C { { g(f($0)) } }
let shout = compose({ (s: String) in s.uppercased() }, { $0 + "!" })
print(shout("hello"))

// Storing closures: a dictionary of operations.
let operations: [String: (Double, Double) -> Double] = ["+": (+), "-": (-), "×": (*), "÷": (/)]
for symbol in ["+", "-", "×", "÷"] { print("12 \(symbol) 4 = \(operations[symbol]!(12, 4))") }

// @escaping closures run later: here, saved up and run at the end.
var later: [() -> Void] = []
func schedule(_ work: @escaping () -> Void) { later.append(work) }
for word in ["ready", "set", "go"] { schedule { print(word, terminator: " ") } }
later.forEach { $0() }
print("")

=== error-handling | Handling Errors | Learn Swift | exclamationmark.shield.fill | throw, try, catch, your own error types, and Result.
--- main.swift
import Foundation

enum AgeError: Error, CustomStringConvertible {
    case notANumber(String)
    case outOfRange(Int)

    var description: String {
        switch self {
        case .notANumber(let text): return "\"\(text)\" isn't a whole number"
        case .outOfRange(let age): return "\(age) isn't a realistic age"
        }
    }
}

// A function that can fail is marked throws.
func parseAge(_ text: String) throws -> Int {
    guard let age = Int(text) else { throw AgeError.notANumber(text) }
    guard (0...130).contains(age) else { throw AgeError.outOfRange(age) }
    return age
}

// do / try / catch.
for text in ["42", "abc", "-5", "999"] {
    do {
        print("\"\(text)\" → age \(try parseAge(text))")
    } catch let error as AgeError {
        print("\"\(text)\" → rejected: \(error)")
    } catch {
        print("unexpected: \(error)")
    }
}

// try? turns a failure into nil; ?? supplies a default.
print("try?: \(String(describing: try? parseAge("x"))), with default: \((try? parseAge("x")) ?? 18)")

// defer runs when the scope ends, however it ends. Good for cleaning up.
func process(_ text: String) -> String {
    print("  open")
    defer { print("  close (always runs)") }
    guard let age = try? parseAge(text) else { return "gave up" }
    return "processed \(age)"
}
print(process("30"))
print(process("oops"))

// Result stores success or failure as a value you can pass around.
func divide(_ a: Double, by b: Double) -> Result<Double, AgeError> {
    b == 0 ? .failure(.notANumber("divide by zero")) : .success(a / b)
}
for (a, b) in [(10.0, 4.0), (1.0, 0.0)] {
    switch divide(a, by: b) {
    case .success(let value): print("\(a) / \(b) = \(value)")
    case .failure(let error): print("\(a) / \(b) failed: \(error)")
    }
}

// Errors travel up through throwing functions until someone catches them.
func averageAge(_ texts: [String]) throws -> Double {
    let ages = try texts.map(parseAge)
    return Double(ages.reduce(0, +)) / Double(ages.count)
}
print((try? averageAge(["20", "30", "40"])) ?? -1, (try? averageAge(["20", "x"])) ?? -1)

=== collections | Arrays, Dictionaries & Sets | Learn Swift | square.stack.3d.down.right.fill | The everyday tools for lists of data: map, filter, reduce, grouping and sorting.
--- main.swift
import Foundation

struct Person {
    let name: String
    let age: Int
    let city: String
}

let people = [
    Person(name: "Ada", age: 36, city: "London"),
    Person(name: "Linus", age: 28, city: "Helsinki"),
    Person(name: "Grace", age: 45, city: "New York"),
    Person(name: "Alan", age: 41, city: "London"),
]

print("map:        \(people.map(\.name))")
print("filter:     \(people.filter { $0.age > 40 }.map(\.name))")
print("reduce:     total age \(people.reduce(0) { $0 + $1.age })")
print("sorted:     \(people.sorted { $0.age < $1.age }.map(\.name))")
print("first:      \(people.first { $0.city == "Helsinki" }?.name ?? "nobody")")
print("contains:   under 30? \(people.contains { $0.age < 30 }), all adults? \(people.allSatisfy { $0.age >= 18 })")
print("max:        \(people.max { $0.age < $1.age }?.name ?? "")")

// Dictionaries.
let ageByName = Dictionary(uniqueKeysWithValues: people.map { ($0.name, $0.age) })
print("lookup:     Ada is \(ageByName["Ada"] ?? 0), Zed is \(ageByName["Zed"] ?? 0)")
let byCity = Dictionary(grouping: people, by: \.city).mapValues { $0.map(\.name) }
for city in byCity.keys.sorted() { print("  \(city): \(byCity[city]!)") }

var wordCounts: [String: Int] = [:]
for word in "the cat and the hat and the bat".split(separator: " ") { wordCounts[String(word), default: 0] += 1 }
print("counts:     " + wordCounts.sorted { $0.value > $1.value }.map { "\($0.key)=\($0.value)" }.joined(separator: " "))

// Sets: no duplicates, fast lookups.
let a: Set = [1, 2, 3, 4], b: Set = [3, 4, 5]
print("sets:       union \(a.union(b).sorted()), both \(a.intersection(b).sorted()), only a \(a.subtracting(b).sorted())")
print("unique:     \(Array(Set(people.map(\.city))).sorted())")

// Handy extras.
let numbers = Array(1...10)
print("slices:     \(numbers.prefix(3)) \(numbers.suffix(2)) \(numbers[2...4])")
print("zip:        \(Array(zip(people.map(\.name), numbers)).prefix(2))")
print("enumerated: " + people.enumerated().map { "\($0.offset + 1).\($0.element.name)" }.joined(separator: " "))
var chunks: [[Int]] = []
for start in stride(from: 0, to: numbers.count, by: 4) { chunks.append(Array(numbers[start..<min(start + 4, numbers.count)])) }
print("chunks:     \(chunks)")
print("flatMap:    \([[1, 2], [3], [4, 5]].flatMap { $0 })")
let squares = numbers.lazy.map { $0 * $0 }
let firstBig: Int = squares.first { $0 > 50 && $0 % 2 == 0 } ?? 0
print("lazy:       first even square over 50 is \(firstBig)")

=== codable-json | JSON with Codable | Learn Swift | curlybraces.square.fill | Turn JSON text into Swift types and back with almost no code.
--- main.swift
import Foundation

let json = """
{
  "app": "MangoIDE",
  "version": 1.5,
  "users": [
    {"name": "Ada", "is_active": true, "tags": ["admin", "dev"], "joined": 2019},
    {"name": "Linus", "is_active": false, "tags": ["dev"]},
    {"name": "Grace", "is_active": true, "tags": []}
  ]
}
"""

// Matching the JSON's shape is all it takes.
struct User: Codable {
    let name: String
    let isActive: Bool
    let tags: [String]
    let joined: Int?            // optional: may be missing

    // Map the JSON's names to Swift-style names.
    enum CodingKeys: String, CodingKey {
        case name, tags, joined
        case isActive = "is_active"
    }
}

struct AppInfo: Codable {
    let app: String
    let version: Double
    var users: [User]
}

do {
    var info = try JSONDecoder().decode(AppInfo.self, from: Data(json.utf8))
    print("\(info.app) v\(info.version) has \(info.users.count) users")
    for user in info.users {
        let joined = user.joined.map { "joined \($0)" } ?? "join year unknown"
        print("  \(user.isActive ? "🟢" : "⚪️") \(user.name): \(user.tags.isEmpty ? "no tags" : user.tags.joined(separator: ", ")), \(joined)")
    }

    // Change it and turn it back into JSON.
    info.users.append(User(name: "Alan", isActive: true, tags: ["logic"], joined: 2024))
    let encoder = JSONEncoder()
    encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
    let output = try encoder.encode(info.users.filter(\.isActive))
    print("\nActive users as JSON:\n" + String(decoding: output, as: UTF8.self))
} catch {
    print("Couldn't read the JSON: \(error)")
}

// Bad JSON gives a clear error instead of a crash.
do {
    _ = try JSONDecoder().decode(AppInfo.self, from: Data("{\"app\": 42}".utf8))
} catch DecodingError.typeMismatch(_, let context) {
    print("\nWrong type at \(context.codingPath.map(\.stringValue).joined(separator: ".")): \(context.debugDescription)")
} catch {
    print("\nOther error: \(error)")
}

=== async-await | async / await | Learn Swift | bolt.horizontal.fill | Run slow jobs one after another or side by side with Swift concurrency.
--- main.swift
import Foundation

struct DownloadError: Error {
    let name: String
}

func download(_ name: String, seconds: Double, fails: Bool = false) async throws -> String {
    try await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
    if fails { throw DownloadError(name: name) }
    return "\(name).zip"
}

func elapsed(since start: Date) -> String { String(format: "%.1fs", Date().timeIntervalSince(start)) }

// One after another: the waits add up.
var start = Date()
let first = try await download("photos", seconds: 0.3)
let second = try await download("music", seconds: 0.2)
print("One by one:  \(first), \(second) in \(elapsed(since: start))")

// async let starts them together: done when the slowest finishes.
start = Date()
async let photos = download("photos", seconds: 0.3)
async let music = download("music", seconds: 0.2)
async let docs = download("docs", seconds: 0.1)
let all = try await [photos, music, docs]
print("All at once: \(all) in \(elapsed(since: start))")

// A task group handles any number of jobs.
start = Date()
let files = try await withThrowingTaskGroup(of: String.self) { group -> [String] in
    for i in 1...5 {
        group.addTask { try await download("file\(i)", seconds: 0.05 * Double(i)) }
    }
    var finished: [String] = []
    for try await file in group { finished.append(file) }
    return finished
}
print("Task group:  \(files.count) files in \(elapsed(since: start)), in the order they finished: \(files)")

// Errors work like normal throwing code.
do {
    _ = try await download("broken", seconds: 0.1, fails: true)
} catch let error as DownloadError {
    print("Caught:      \(error.name) failed to download")
}

// An actor keeps shared data safe when many tasks touch it at once.
actor Counter {
    private(set) var value = 0
    func increment() { value += 1 }
}
let counter = Counter()
await withTaskGroup(of: Void.self) { group in
    for _ in 0..<1000 { group.addTask { await counter.increment() } }
}
print("Actor:       1,000 tasks counted to \(await counter.value) with no lost updates")

=== property-wrappers | Property Wrappers | Learn Swift | shippingbox.fill | Reusable rules for properties: clamp a number, trim text, log every change.
--- main.swift
import Foundation

// A property wrapper holds the value and decides what happens when it's read or set.
@propertyWrapper
struct Clamped {
    private var value: Int
    let range: ClosedRange<Int>

    init(wrappedValue: Int, _ range: ClosedRange<Int>) {
        self.range = range
        self.value = min(max(wrappedValue, range.lowerBound), range.upperBound)
    }

    var wrappedValue: Int {
        get { value }
        set { value = min(max(newValue, range.lowerBound), range.upperBound) }
    }
}

@propertyWrapper
struct Trimmed {
    private var value = ""
    init(wrappedValue: String) { self.wrappedValue = wrappedValue }
    var wrappedValue: String {
        get { value }
        set { value = newValue.trimmingCharacters(in: .whitespacesAndNewlines) }
    }
}

/// Remembers every value it was given. $name gives access to the history.
@propertyWrapper
struct Tracked<Value> {
    private(set) var history: [Value]
    init(wrappedValue: Value) { history = [wrappedValue] }
    var wrappedValue: Value {
        get { history[history.count - 1] }
        set { history.append(newValue) }
    }
    var projectedValue: [Value] { history }
}

struct Player {
    @Trimmed var name: String = ""
    @Clamped(0...100) var health: Int = 100
    @Clamped(1...99) var level: Int = 1
    @Tracked var score: Int = 0
}

var player = Player(name: "   Mango  ")
print("name is trimmed: \"\(player.name)\"")

player.health -= 250
print("health can't go below 0: \(player.health)")
player.health += 9999
print("or above 100: \(player.health)")
player.level = 0
print("level stays at least 1: \(player.level)")

for points in [10, 25, 5] { player.score += points }
print("score: \(player.score), history: \(player.$score)")

// The same thing by hand, to show what the wrapper saves you from writing.
struct PlainPlayer {
    private var storedHealth = 100
    var health: Int {
        get { storedHealth }
        set { storedHealth = min(max(newValue, 0), 100) }
    }
}
var plain = PlainPlayer()
plain.health = -5
print("without a wrapper you repeat this for every property: \(plain.health)")

=== strings | Working with Strings | Learn Swift | textformat.abc | Search, split, format and pull text apart, including emoji-safe indexing.
--- main.swift
import Foundation

let text = "  The quick brown fox jumps over the lazy dog  "
let clean = text.trimmingCharacters(in: .whitespaces)

print("count:       \(clean.count) characters, \(clean.split(separator: " ").count) words")
print("upper/lower: \(clean.uppercased().prefix(9)) / \(clean.lowercased().prefix(9))")
print("contains:    fox? \(clean.contains("fox")), starts with The? \(clean.hasPrefix("The")), ends with dog? \(clean.hasSuffix("dog"))")
print("replace:     \(clean.replacingOccurrences(of: "lazy", with: "sleepy"))")
print("split/join:  \(clean.split(separator: " ").map { $0.capitalized }.joined(separator: "-"))")
print("reversed:    \(String(clean.reversed()))")

// Characters can be several bytes, so Swift uses indexes instead of numbers.
let word = "Mango 🥭 café"
print("\ncharacters:  \(word.count), bytes in UTF-8: \(word.utf8.count)")
print("first/last:  \(word.first!) \(word.last!)")
let start = word.index(word.startIndex, offsetBy: 6)
print("7th char:    \(word[start])")
print("first five:  \(word.prefix(5)), last four: \(word.suffix(4))")
if let space = word.firstIndex(of: " ") { print("up to space: \(word[..<space])") }
print("as an array: \(Array(word.prefix(5)))")

// Building and formatting.
let name = "Ada", score = 97.456
print("\ninterpolate: \(name) scored \(score.rounded()) (\(score > 90 ? "great" : "ok"))")
print("format:      " + String(format: "%.1f%%  |%5d|  |%-8.2f|  %03d", score, 42, 3.14159, 7))
print("padding:     [" + name.padding(toLength: 8, withPad: ".", startingAt: 0) + "]")
print("repeat:      " + String(repeating: "=-", count: 10))
print("multi-line:")
print("""
    Dear \(name),
      your score was \(Int(score)).
    """)

// Checking and converting.
print("numbers:     Int(\"42\") = \(Int("42") ?? 0), Double(\"3.5\") = \(Double("3.5") ?? 0), Int(\"x\") = \(String(describing: Int("x")))")
print("letters only? \("Swift".allSatisfy { $0.isLetter }), digits only? \("2024".allSatisfy { $0.isNumber })")
let vowels = clean.lowercased().filter { "aeiou".contains($0) }.count
print("vowels:      \(vowels)")
print("compare:     \("apple" < "banana"), same ignoring case? \("SWIFT".caseInsensitiveCompare("swift") == .orderedSame)")
print("palindrome:  \(["level", "swift"].map { "\($0)=\($0 == String($0.reversed()))" })")

=== unit-tests | Tiny Test Runner | Learn Swift | checkmark.seal.fill | Test your own functions with a small runner you can read in one screen.
--- main.swift
// Real apps use XCTest in Xcode. This shows the same idea in a single file.
import Foundation

// The code being tested.
func total(_ prices: [Double], tax: Double = 0.08) -> Double {
    (prices.reduce(0, +) * (1 + tax) * 100).rounded() / 100
}

enum DiscountError: Error { case badPercent }

func discount(_ price: Double, percent: Double) throws -> Double {
    guard (0...100).contains(percent) else { throw DiscountError.badPercent }
    return (price * (1 - percent / 100) * 100).rounded() / 100
}

func slug(_ title: String) -> String {
    title.lowercased().split { !$0.isLetter && !$0.isNumber }.joined(separator: "-")
}

// The runner.
var passed = 0, failed = 0

func expect<T: Equatable>(_ actual: T, equals expected: T, _ name: String) {
    if actual == expected {
        passed += 1
        print("✅ \(name)")
    } else {
        failed += 1
        print("❌ \(name): expected \(expected), got \(actual)")
    }
}

func expectThrows(_ name: String, _ body: () throws -> Void) {
    do {
        try body()
        failed += 1
        print("❌ \(name): expected an error, but nothing was thrown")
    } catch {
        passed += 1
        print("✅ \(name)")
    }
}

// The tests. Break one of the functions above and run again to see a failure.
expect(total([10, 20]), equals: 32.4, "total adds tax")
expect(total([]), equals: 0, "total of nothing is zero")
expect(total([10], tax: 0), equals: 10, "tax can be turned off")
expect(try! discount(80, percent: 25), equals: 60, "discount takes a quarter off")
expectThrows("discount rejects 150%") { _ = try discount(80, percent: 150) }
expect(slug("Hello, Big World!"), equals: "hello-big-world", "slug replaces punctuation")
expect(slug("  Swift 6  "), equals: "swift-6", "slug trims the ends")

print("\n\(passed) passed, \(failed) failed")
print(failed == 0 ? "All good ✅" : "Some tests failed ❌")
