=== html-scraper | Web Page Scraper | Internet | doc.richtext.fill | Pull the links and headings out of a web page's HTML.
--- main.py
"""Read HTML and collect its headings and links with the built-in HTMLParser."""
from html.parser import HTMLParser

PAGE = """
<html><body>
  <h1>Mango Recipes</h1>
  <p>Fresh ideas, <a href="/smoothies">smoothies</a> first.</p>
  <h2>Sweet</h2>
  <ul><li><a href="/sorbet">Mango sorbet</a></li><li><a href="/lassi">Mango lassi</a></li></ul>
  <h2>Savory</h2>
  <p>Try the <a href="https://example.com/salsa">salsa</a>.</p>
</body></html>
"""


class Collector(HTMLParser):
    def __init__(self):
        super().__init__()
        self.headings, self.links = [], []
        self._tag, self._href = None, None

    def handle_starttag(self, tag, attrs):
        self._tag = tag
        if tag == "a":
            self._href = dict(attrs).get("href")

    def handle_data(self, data):
        text = data.strip()
        if not text:
            return
        if self._tag in ("h1", "h2", "h3"):
            self.headings.append((self._tag, text))
        elif self._tag == "a" and self._href:
            self.links.append((text, self._href))

    def handle_endtag(self, tag):
        self._tag = None


def main():
    collector = Collector()
    collector.feed(PAGE)
    print("Headings:")
    for level, text in collector.headings:
        print(f"  {'  ' * (int(level[1]) - 1)}{text}")
    print("Links:")
    for text, href in collector.links:
        print(f"  {text:<14} → {href}")


if __name__ == "__main__":
    main()

