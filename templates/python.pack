=== pomodoro | Focus Timer (Pomodoro) | Tools | hourglass | Work and break rounds with a live progress bar.
--- main.py
"""A focus timer: work rounds and breaks. Minutes are shortened to seconds so you can try it fast."""
import time

SPEED = 60  # 60 = a "minute" lasts one second. Set to 1 for real minutes.


def run(label, minutes):
    total = max(1, round(minutes * 60 / SPEED))
    for done in range(total + 1):
        width = 24
        filled = round(width * done / total)
        print(f"{label:<6} {'█' * filled}{'░' * (width - filled)} {done * 100 // total:>3}%")
        if done < total:
            time.sleep(1)


def main():
    rounds_text = input("How many rounds [2]: ").strip()
    rounds = int(rounds_text) if rounds_text.isdigit() else 2
    for n in range(1, rounds + 1):
        print(f"\nRound {n}/{rounds}")
        run("Focus", 5)
        if n < rounds:
            run("Break", 2)
    print("\nDone. Nice work! ✅")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        run("Focus", 3)

