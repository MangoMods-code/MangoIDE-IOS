ROOMS = {
    "hall": {"text": "A dusty hall. Doors lead north and east.", "north": "library", "east": "kitchen"},
    "library": {"text": "Shelves of old books. A brass key glints on a desk.", "south": "hall", "item": "key"},
    "kitchen": {"text": "A cold kitchen. A locked door leads north.", "west": "hall", "north": "garden", "locked": "north"},
    "garden": {"text": "Sunlight! You made it outside. 🌳", "end": True},
}


def main():
    room, bag = "hall", set()
    print("Commands: north/south/east/west, take, bag, quit")
    while True:
        here = ROOMS[room]
        print("\n" + here["text"])
        if here.get("end"):
            break
        cmd = input("> ").strip().lower()
        if cmd in ("quit", "q"):
            break
        elif cmd == "bag":
            print("You carry:", ", ".join(bag) or "nothing")
        elif cmd == "take":
            if here.get("item"):
                bag.add(here.pop("item"))
                print("Taken.")
            else:
                print("Nothing to take here.")
        elif cmd in here and cmd in ("north", "south", "east", "west"):
            if here.get("locked") == cmd and "key" not in bag:
                print("The door is locked.")
            else:
                room = here[cmd]
        else:
            print("You can't do that here.")


