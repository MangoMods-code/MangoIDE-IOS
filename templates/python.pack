=== json-explorer | JSON Explorer | Data | curlybraces.square.fill | Load a JSON file and walk through it as a tree.
--- main.py
"""Print any JSON file as a tree and pull values out by path."""
import json
from pathlib import Path

FILE = Path(__file__).with_name("data.json")


def tree(value, indent=0, key=None):
    pad = "  " * indent
    label = f"{key}: " if key is not None else ""
    if isinstance(value, dict):
        print(f"{pad}{label}{{{len(value)} keys}}")
        for k, v in value.items():
            tree(v, indent + 1, k)
    elif isinstance(value, list):
        print(f"{pad}{label}[{len(value)} items]")
        for i, v in enumerate(value):
            tree(v, indent + 1, i)
    else:
        print(f"{pad}{label}{value!r}")


def get(value, path):
    """get(data, 'users.0.name') → follows keys and list positions."""
    for part in path.split("."):
        value = value[int(part)] if isinstance(value, list) else value[part]
    return value


def main():
    data = json.loads(FILE.read_text())
    tree(data)
    print("\nusers.0.name →", get(data, "users.0.name"))
    print("Active users →", [u["name"] for u in data["users"] if u["active"]])


if __name__ == "__main__":
    main()
