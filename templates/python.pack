=== todo-list | To-Do List | Tools | checklist | Add, tick off and remove tasks. Saved to a file between runs.
--- main.py
"""A to-do list saved in todos.json next to this file."""
import json
from pathlib import Path

FILE = Path(__file__).with_name("todos.json")


def load():
    return json.loads(FILE.read_text()) if FILE.exists() else []


def save(todos):
    FILE.write_text(json.dumps(todos, indent=2))


def show(todos):
    print()
    if not todos:
        print("Nothing to do. 🎉")
    for i, t in enumerate(todos, 1):
        print(f"{i:>2}. [{'x' if t['done'] else ' '}] {t['text']}")


def main():
    todos = load()
    print("Commands: add <task>, done <number>, remove <number>, quit")
    while True:
        show(todos)
        cmd, _, rest = input("> ").strip().partition(" ")
        if cmd in ("quit", "q", ""):
            break
        if cmd == "add" and rest:
            todos.append({"text": rest, "done": False})
        elif cmd in ("done", "remove") and rest.isdigit() and 1 <= int(rest) <= len(todos):
            if cmd == "done":
                todos[int(rest) - 1]["done"] = True
            else:
                todos.pop(int(rest) - 1)
        else:
            print("Try: add Buy milk")
            continue
        save(todos)


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== password-generator | Password Generator | Tools | key.fill | Make strong random passwords and passphrases.
--- main.py
"""Generate strong passwords using Python's secure random source."""
import secrets
import string

WORDS = ["mango", "river", "cloud", "tiger", "piano", "lemon", "rocket", "forest", "ember", "comet", "maple", "otter"]


def password(length=16, symbols=True):
    alphabet = string.ascii_letters + string.digits + ("!@#$%^&*-_" if symbols else "")
    while True:
        pw = "".join(secrets.choice(alphabet) for _ in range(length))
        if any(c.islower() for c in pw) and any(c.isupper() for c in pw) and any(c.isdigit() for c in pw):
            return pw


def passphrase(words=4):
    return "-".join(secrets.choice(WORDS) for _ in range(words)) + str(secrets.randbelow(90) + 10)


def main():
    print("Three passwords:")
    for _ in range(3):
        print("  ", password())
    print("Three passphrases (easier to remember):")
    for _ in range(3):
        print("  ", passphrase())
    text = input("\nLength for a custom one [20]: ").strip()
    print(password(int(text) if text.isdigit() and 6 <= int(text) <= 128 else 20))


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== unit-converter | Unit Converter | Tools | ruler.fill | Convert lengths, weights and volumes: 5 km to mi.
--- main.py
"""Convert units by going through a base unit. Add more to UNITS."""

UNITS = {
    "length": {"mm": 0.001, "cm": 0.01, "m": 1, "km": 1000, "in": 0.0254, "ft": 0.3048, "yd": 0.9144, "mi": 1609.344},
    "weight": {"g": 1, "kg": 1000, "oz": 28.3495, "lb": 453.592},
    "volume": {"ml": 1, "l": 1000, "cup": 236.588, "gal": 3785.41},
}


def convert(value, src, dst):
    for table in UNITS.values():
        if src in table and dst in table:
            return value * table[src] / table[dst]
    raise ValueError(f"Can't convert {src} to {dst}.")


def main():
    print("Try: 5 km to mi   (q to quit)")
    print("Units:", ", ".join(u for t in UNITS.values() for u in t))
    while True:
        parts = input("> ").lower().split()
        if not parts or parts[0] == "q":
            break
        try:
            value, src, dst = float(parts[0]), parts[1], parts[-1]
            print(f"{value:g} {src} = {convert(value, src, dst):.4g} {dst}")
        except (ValueError, IndexError) as e:
            print(e if isinstance(e, ValueError) and "convert" in str(e) else "Write it like: 5 km to mi")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== expense-tracker | Expense Tracker | Tools | creditcard.fill | Log spending by category and see where the money goes.
--- main.py
"""Track expenses in expenses.csv and total them by category."""
import csv
from collections import defaultdict
from datetime import date
from pathlib import Path

FILE = Path(__file__).with_name("expenses.csv")


def load():
    if not FILE.exists():
        return []
    with FILE.open(newline="") as f:
        return [(r["date"], r["category"], float(r["amount"]), r["note"]) for r in csv.DictReader(f)]


def add(category, amount, note=""):
    new = not FILE.exists()
    with FILE.open("a", newline="") as f:
        w = csv.writer(f)
        if new:
            w.writerow(["date", "category", "amount", "note"])
        w.writerow([date.today().isoformat(), category, f"{amount:.2f}", note])


def report(rows):
    totals = defaultdict(float)
    for _, category, amount, _ in rows:
        totals[category] += amount
    biggest = max(totals.values(), default=1)
    for category, amount in sorted(totals.items(), key=lambda kv: -kv[1]):
        print(f"{category:<12} ${amount:>8.2f} {'█' * round(20 * amount / biggest)}")
    print(f"{'TOTAL':<12} ${sum(totals.values()):>8.2f}")


def main():
    if not load():
        for sample in (("food", 12.5, "lunch"), ("transport", 2.75, "bus"), ("food", 30, "groceries")):
            add(*sample)
    print("Commands: add <category> <amount> [note], report, quit")
    report(load())
    while True:
        parts = input("> ").split(maxsplit=3)
        if not parts or parts[0] in ("q", "quit"):
            break
        if parts[0] == "add" and len(parts) >= 3:
            try:
                add(parts[1], float(parts[2]), parts[3] if len(parts) > 3 else "")
                print("Added.")
            except ValueError:
                print("The amount should be a number.")
        elif parts[0] == "report":
            report(load())
        else:
            print("Try: add food 8.50 coffee")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

