=== calculator | Calculator | Starter | plusminus.circle.fill | Type sums like 3 * (4 + 5) and get the answer, safely.
--- main.py
"""A calculator that understands + - * / ** % and brackets, without using eval()."""
import ast
import operator

OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
       ast.Pow: operator.pow, ast.Mod: operator.mod, ast.FloorDiv: operator.floordiv,
       ast.USub: operator.neg, ast.UAdd: operator.pos}


def evaluate(node):
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in OPS:
        return OPS[type(node.op)](evaluate(node.left), evaluate(node.right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in OPS:
        return OPS[type(node.op)](evaluate(node.operand))
    raise ValueError("I only understand numbers and + - * / ** % ( )")


def calculate(text):
    return evaluate(ast.parse(text, mode="eval").body)


def main():
    print("Calculator. Type a sum, or 'q' to quit.")
    while True:
        text = input("> ").strip()
        if text.lower() in ("q", "quit", "exit"):
            break
        if not text:
            continue
        try:
            print("=", calculate(text))
        except ZeroDivisionError:
            print("Can't divide by zero.")
        except (ValueError, SyntaxError) as e:
            print("Hmm:", e)


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== temperature | Temperature Converter | Starter | thermometer.medium | Convert between Celsius, Fahrenheit and Kelvin.
--- main.py
"""Convert a temperature between Celsius, Fahrenheit and Kelvin."""


def to_celsius(value, unit):
    return {"c": value, "f": (value - 32) * 5 / 9, "k": value - 273.15}[unit]


def from_celsius(c):
    return {"C": c, "F": c * 9 / 5 + 32, "K": c + 273.15}


def main():
    print("Type a temperature like 72f, 21c or 300k (q to quit).")
    while True:
        text = input("> ").strip().lower()
        if text in ("q", ""):
            break
        try:
            value, unit = float(text[:-1]), text[-1]
            results = from_celsius(to_celsius(value, unit))
        except (ValueError, KeyError):
            print("Use a number followed by c, f or k.")
            continue
        print("  ".join(f"{v:.1f}°{u}" for u, v in results.items()))


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

