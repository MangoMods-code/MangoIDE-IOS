    guessed, lives = set(), 6
    while lives and not set(word) <= guessed:
        print(f"\n{show(word, guessed)}   lives: {'♥' * lives}   tried: {' '.join(sorted(guessed))}")
        letter = input("Letter: ").strip().lower()
        if len(letter) != 1 or not letter.isalpha():
            print("One letter, please.")
        elif letter in guessed:
            print("You tried that already.")
        else:
            guessed.add(letter)
            if letter not in word:
                lives -= 1
                print("Nope.")
    print(f"\nYou got it: {word}! 🎉" if lives else f"\nOut of lives. The word was {word}.")


if __name__ == "__main__":
