import unittest

from shop import discount, total


class ShopTests(unittest.TestCase):
    def test_total_adds_tax(self):
        self.assertEqual(total([10, 20]), 32.4)

    def test_total_of_nothing_is_zero(self):
        self.assertEqual(total([]), 0)

    def test_discount(self):
        self.assertEqual(discount(80, 25), 60)

    def test_discount_rejects_bad_percent(self):
        with self.assertRaises(ValueError):
            discount(80, 150)

=== error-handling | Handling Errors | Learn Python | exclamationmark.shield.fill | try, except, else, finally and your own error types.
--- main.py
"""How to catch errors, clean up afterwards and raise your own."""


class AgeError(ValueError):
    """Raised when an age makes no sense."""


def parse_age(text):
    try:
        age = int(text)
    except ValueError:
        raise AgeError(f"{text!r} isn't a whole number") from None
    if not 0 <= age <= 130:
        raise AgeError(f"{age} isn't a realistic age")
    return age


def safe_divide(a, b):
    try:
        result = a / b
    except ZeroDivisionError:
        print("  can't divide by zero, using 0")
        return 0
    else:
        print("  division worked")
        return result
    finally:
        print("  (finally always runs)")


def main():
    for text in ("42", "abc", "-5", "999"):
        try:
            print(f"{text!r} → age {parse_age(text)}")
        except AgeError as e:
            print(f"{text!r} → rejected: {e}")
    print(safe_divide(10, 2))
    print(safe_divide(1, 0))
    data = {"name": "Ada"}
    print("Missing key with a default:", data.get("email", "no email"))


if __name__ == "__main__":
    main()

