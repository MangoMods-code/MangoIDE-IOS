--- main.py
"""A contact book stored in contacts.json."""
import json
from pathlib import Path

FILE = Path(__file__).with_name("contacts.json")


def load():
    return json.loads(FILE.read_text()) if FILE.exists() else {}


def main():
    contacts = load()
    print("Commands: add <name> <phone>, find <text>, delete <name>, list, quit")
    while True:
        parts = input("> ").split()
        if not parts or parts[0] in ("q", "quit"):
            break
        cmd, args = parts[0], parts[1:]
        if cmd == "add" and len(args) >= 2:
            contacts[" ".join(args[:-1])] = args[-1]
        elif cmd == "delete" and args:
            if contacts.pop(" ".join(args), None) is None:
                print("No contact with that name.")
        elif cmd in ("list", "find"):
            needle = " ".join(args).lower()
            matches = {n: p for n, p in sorted(contacts.items()) if needle in n.lower() or needle in p}
            for name, phone in matches.items():
                print(f"{name:<20} {phone}")
            print(f"{len(matches)} contact(s)")
            continue
        else:
            print("Try: add Ada Lovelace 555-0100")
            continue
        FILE.write_text(json.dumps(contacts, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== text-stats | Text Analyzer | Tools | text.magnifyingglass | Count words, sentences and the most common words in any text.
--- main.py
"""Paste some text and get word counts, reading time and the most common words."""
import re
from collections import Counter

SAMPLE = """Python is a programming language that lets you work quickly.
It is easy to read, easy to learn, and powerful enough for real projects.
Many people learn Python first because the code reads almost like English."""

COMMON = {"the", "a", "an", "and", "is", "it", "to", "of", "for", "that", "you", "in", "on", "like"}


def analyze(text):
    words = re.findall(r"[A-Za-z']+", text.lower())
    sentences = [s for s in re.split(r"[.!?]+", text) if s.strip()]
    return {
        "characters": len(text),
        "words": len(words),
        "sentences": len(sentences),
        "avg word length": round(sum(map(len, words)) / max(1, len(words)), 1),
        "reading time (s)": round(len(words) / 200 * 60),
        "top words": Counter(w for w in words if w not in COMMON).most_common(5),
    }


def main():
    print("Paste text and press return on an empty line (or just press return for a sample).")
    lines = []
    while True:
        line = input()
        if not line:
            break
        lines.append(line)
    for key, value in analyze("\n".join(lines) or SAMPLE).items():
        print(f"{key:<18} {value}")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        for key, value in analyze(SAMPLE).items():
            print(f"{key:<18} {value}")

=== caesar-cipher | Secret Code (Caesar Cipher) | Tools | lock.rotation | Scramble and unscramble messages by shifting letters.
--- main.py
"""Encode and decode messages with a Caesar cipher, and crack one without the key."""
import string


def shift(text, key):
    out = []
    for ch in text:
        if ch.isalpha():
            base = ord("A") if ch.isupper() else ord("a")
            out.append(chr((ord(ch) - base + key) % 26 + base))
        else:
            out.append(ch)
    return "".join(out)


def crack(secret):
    """Try all 26 keys and pick the one that looks most like English."""
    common = "etaoinshr"
    return max(range(26), key=lambda k: sum(shift(secret, -k).lower().count(c) for c in common))


def main():
    message = input("Message [Meet me at the mango tree]: ").strip() or "Meet me at the mango tree"
    key_text = input("Shift 1-25 [3]: ").strip()
    key = int(key_text) % 26 if key_text.isdigit() else 3
    secret = shift(message, key)
    print("Encoded:", secret)
    print("Decoded:", shift(secret, -key))
    print("Cracked key without being told:", crack(secret))


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\n" + shift("Meet me at the mango tree", 3))

