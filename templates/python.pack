"""A small turn-based RPG. Game rules live in game/, this file runs the loop."""
import random

from game.battle import fight
from game.characters import Hero, random_monster


def main():
    hero = Hero(input("Name your hero [Mango]: ").strip() or "Mango")
    while hero.alive:
        monster = random_monster(hero.level)
        print(f"\nA wild {monster.name} appears! (HP {monster.hp})")
        if not fight(hero, monster, lambda: input("[a]ttack, [h]eal or [r]un? ").strip().lower()[:1]):
            break
        print(hero.status())
        if input("Keep exploring? [y/n] ").strip().lower().startswith("n"):
            break
    print(f"\n{hero.name} retires at level {hero.level} with {hero.gold} gold.")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        random.seed(1)
        hero = Hero("Mango")
        fight(hero, random_monster(1), lambda: "a")
        print(hero.status())
--- game/__init__.py
--- game/characters.py
import random
from dataclasses import dataclass


@dataclass
class Fighter:
    name: str
    hp: int
    attack: int

    @property
    def alive(self):
        return self.hp > 0

    def hit(self, other):
        damage = random.randint(self.attack // 2, self.attack)
        other.hp = max(0, other.hp - damage)
        return damage


class Hero(Fighter):
    def __init__(self, name):
        super().__init__(name, hp=30, attack=8)
        self.level, self.xp, self.gold, self.potions = 1, 0, 0, 2

    def gain(self, xp, gold):
        self.xp, self.gold = self.xp + xp, self.gold + gold
        while self.xp >= self.level * 10:
            self.xp -= self.level * 10
            self.level += 1
            self.attack += 2
            self.hp += 10
            print(f"⬆️  Level {self.level}!")

    def status(self):
        return f"{self.name}: level {self.level}, HP {self.hp}, {self.gold} gold, {self.potions} potions"


MONSTERS = [("Slime", 10, 4), ("Goblin", 16, 6), ("Wolf", 20, 7), ("Ogre", 30, 9)]


def random_monster(level):
    name, hp, attack = random.choice(MONSTERS[: min(len(MONSTERS), level + 1)])
    return Fighter(name, hp + level * 2, attack + level)
--- game/battle.py
import random


def fight(hero, monster, choose):
    """Returns True if the hero survives (won or ran away)."""
    while hero.alive and monster.alive:
        action = choose()
        if action == "r" and random.random() < 0.6:
            print("You got away.")
            return True
        if action == "h" and hero.potions:
            hero.potions -= 1
            hero.hp += 15
            print(f"You drink a potion. HP {hero.hp}")
        else:
            print(f"You hit the {monster.name} for {hero.hit(monster)}. (its HP {monster.hp})")
        if monster.alive:
            print(f"The {monster.name} hits you for {monster.hit(hero)}. (your HP {hero.hp})")
    if hero.alive:
        gold = random.randint(3, 12)
        print(f"You beat the {monster.name} and find {gold} gold!")
        hero.gain(xp=8, gold=gold)
    else:
        print("You were defeated…")
    return hero.alive

=== library-manager | Library Manager (multi-file) | Projects | books.vertical.fill | Models, a service layer and tests: how bigger programs are organized.
--- main.py
"""A library that lends books. Models in library/models.py, rules in library/service.py."""
from library.models import Book, Member
from library.service import Library, LendingError


def main():
    lib = Library()
    for title, author in (("Dune", "Frank Herbert"), ("Neuromancer", "William Gibson"), ("Emma", "Jane Austen")):
        lib.add_book(Book(title, author))
    ada, bob = Member("Ada"), Member("Bob", limit=1)
    lib.lend("Dune", ada)
    lib.lend("Emma", bob)
    for attempt in (("Dune", bob), ("Neuromancer", bob), ("Missing Book", ada)):
        try:
            lib.lend(*attempt)
        except LendingError as e:
            print("✗", e)
    lib.give_back("Dune")
    lib.lend("Dune", ada)
    print()
    for line in lib.report():
        print(line)


if __name__ == "__main__":
    main()
--- library/__init__.py
--- library/models.py
from dataclasses import dataclass, field


@dataclass
class Book:
    title: str
    author: str
    borrower: "Member | None" = None

    @property
    def available(self):
        return self.borrower is None


@dataclass
class Member:
    name: str
    limit: int = 3
    books: list = field(default_factory=list)
--- library/service.py
from .models import Book, Member


class LendingError(Exception):
    pass


class Library:
    def __init__(self):
        self.books = {}

    def add_book(self, book: Book):
        self.books[book.title] = book

    def lend(self, title, member: Member):
        book = self.books.get(title)
        if book is None:
            raise LendingError(f"We don't have {title!r}.")
        if not book.available:
            raise LendingError(f"{title!r} is out with {book.borrower.name}.")
        if len(member.books) >= member.limit:
            raise LendingError(f"{member.name} already has {member.limit} book(s).")
        book.borrower = member
        member.books.append(book)

    def give_back(self, title):
        book = self.books[title]
        if book.borrower:
            book.borrower.books.remove(book)
            book.borrower = None

    def report(self):
        return [f"{b.title:<12} {b.author:<16} {'on the shelf' if b.available else 'with ' + b.borrower.name}"
                for b in self.books.values()]
--- test_library.py
"""Run this file to test the lending rules."""
import unittest

from library.models import Book, Member
from library.service import Library, LendingError


class LibraryTests(unittest.TestCase):
    def setUp(self):
        self.lib = Library()
        self.lib.add_book(Book("Dune", "Frank Herbert"))

    def test_lend_and_return(self):
        ada = Member("Ada")
        self.lib.lend("Dune", ada)
        self.assertFalse(self.lib.books["Dune"].available)
        self.lib.give_back("Dune")
        self.assertEqual(ada.books, [])

    def test_cannot_lend_twice(self):
        self.lib.lend("Dune", Member("Ada"))
        with self.assertRaises(LendingError):
            self.lib.lend("Dune", Member("Bob"))


if __name__ == "__main__":
    unittest.main()
