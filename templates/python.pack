--- tasks/__init__.py
"""The tasks package: storage.py saves data, commands.py handles what the user typed."""
--- tasks/storage.py
import json
from pathlib import Path

FILE = Path(__file__).resolve().parent.parent / "tasks.json"


def load():
    return json.loads(FILE.read_text()) if FILE.exists() else []


def save(tasks):
    FILE.write_text(json.dumps(tasks, indent=2))
--- tasks/commands.py
from . import storage


def show(tasks):
    if not tasks:
        print("No tasks yet.")
    for i, task in enumerate(tasks, 1):
        print(f"{i}. [{'x' if task['done'] else ' '}] {task['title']}")


def run(args):
    command, rest = args[0], args[1:]
    tasks = storage.load()
    if command == "add" and rest:
        tasks.append({"title": " ".join(rest), "done": False})
    elif command == "done" and rest and rest[0].isdigit() and 1 <= int(rest[0]) <= len(tasks):
        tasks[int(rest[0]) - 1]["done"] = True
    elif command == "demo":
        tasks = [{"title": "Try Run Settings › Arguments", "done": False}, {"title": "Read tasks/commands.py", "done": True}]
    elif command != "list":
        print("Usage: add <title> | done <number> | list")
        return 2
    storage.save(tasks)
    show(tasks)
    return 0

