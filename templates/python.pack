"""Draw horizontal and vertical bar charts with plain text."""

DATA = {"Mon": 12, "Tue": 18, "Wed": 7, "Thu": 22, "Fri": 15, "Sat": 30, "Sun": 26}


def horizontal(data, width=30):
    top = max(data.values())
    for label, value in data.items():
        print(f"{label:>4} │{'█' * round(width * value / top)} {value}")


def vertical(data, height=8):
    top = max(data.values())
    for level in range(height, 0, -1):
        print(" ".join(" ██ " if value / top * height >= level else "    " for value in data.values()))
    print(" ".join(f"{label:^4}" for label in data))


def main():
    print("Steps (thousands) this week\n")
    horizontal(DATA)
    print()
    vertical(DATA)
    values = list(DATA.values())
    print(f"\nTotal {sum(values)}, average {sum(values) / len(values):.1f}, best day {max(DATA, key=DATA.get)}")


if __name__ == "__main__":
    main()

