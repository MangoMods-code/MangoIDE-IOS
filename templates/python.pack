=== wordle | Word Guess (Wordle-style) | Games | square.grid.3x3.fill | Six tries to find a five-letter word, with color hints.
--- main.py
"""Guess the five-letter word. 🟩 right spot, 🟨 wrong spot, ⬛ not in the word."""
import random

WORDS = ["apple", "brick", "crane", "drive", "eagle", "flame", "grape", "house", "juice", "knife",
         "lemon", "mango", "night", "ocean", "piano", "queen", "river", "stone", "tiger", "water"]


def score(guess, answer):
    marks, left = ["⬛"] * 5, list(answer)
    for i, c in enumerate(guess):
        if c == answer[i]:
            marks[i] = "🟩"
            left.remove(c)
    for i, c in enumerate(guess):
        if marks[i] == "⬛" and c in left:
            marks[i] = "🟨"
            left.remove(c)
    return "".join(marks)


def main():
    answer = random.choice(WORDS)
    for turn in range(1, 7):
        guess = input(f"Guess {turn}/6: ").strip().lower()
        while len(guess) != 5 or not guess.isalpha():
            guess = input("Five letters, please: ").strip().lower()
        print(score(guess, answer), guess.upper())
        if guess == answer:
            print("You got it! 🎉")
            return
    print("The word was", answer.upper())


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== minesweeper | Minesweeper | Games | burst.fill | Uncover the grid without hitting a mine.
--- main.py
"""Console minesweeper on a small grid. Type a row and column, like: 2 3"""
import random

SIZE, MINES = 6, 6


def neighbours(r, c):
    return [(r + dr, c + dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)
            if (dr or dc) and 0 <= r + dr < SIZE and 0 <= c + dc < SIZE]


def reveal(r, c, mines, shown):
    if (r, c) in shown:
        return
    shown.add((r, c))
    if not any(n in mines for n in neighbours(r, c)):
        for n in neighbours(r, c):
            reveal(*n, mines, shown)


def draw(mines, shown, show_all=False):
    print("\n   " + " ".join(str(c + 1) for c in range(SIZE)))
    for r in range(SIZE):
        cells = []
        for c in range(SIZE):
            if (r, c) in mines and show_all:
                cells.append("*")
            elif (r, c) in shown:
                cells.append(str(sum(n in mines for n in neighbours(r, c)) or "·"))
            else:
                cells.append("#")
        print(f"{r + 1}  " + " ".join(cells))


def main():
    cells = [(r, c) for r in range(SIZE) for c in range(SIZE)]
    mines, shown = set(random.sample(cells, MINES)), set()
    while len(shown) < SIZE * SIZE - MINES:
        draw(mines, shown)
        parts = input("Row and column: ").split()
        if len(parts) != 2 or not all(p.isdigit() and 1 <= int(p) <= SIZE for p in parts):
            print(f"Type two numbers from 1 to {SIZE}.")
            continue
        spot = (int(parts[0]) - 1, int(parts[1]) - 1)
        if spot in mines:
            draw(mines, shown, show_all=True)
            print("💥 Boom!")
            return
        reveal(*spot, mines, shown)
    draw(mines, shown, show_all=True)
    print("You cleared the field! 🎉")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

