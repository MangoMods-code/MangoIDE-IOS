=== sorting-visualizer | Sorting Visualizer | Algorithms | chart.bar.xaxis | Watch bubble sort, insertion sort and quicksort step by step.
--- main.py
"""See how three sorting algorithms move numbers around, and count their steps."""
import random


def draw(values, note=""):
    print(" ".join(f"{v:>2}" for v in values), " ", note)


def bubble(values):
    a, steps = values[:], 0
    for end in range(len(a) - 1, 0, -1):
        for i in range(end):
            steps += 1
            if a[i] > a[i + 1]:
                a[i], a[i + 1] = a[i + 1], a[i]
        draw(a, f"largest {a[end]} bubbled to the end")
    return a, steps


def insertion(values):
    a, steps = values[:], 0
    for i in range(1, len(a)):
        item, j = a[i], i - 1
        while j >= 0 and a[j] > item:
            a[j + 1] = a[j]
            j -= 1
            steps += 1
        a[j + 1] = item
        draw(a, f"inserted {item}")
    return a, steps


def quick(values):
    steps = 0

    def sort(a):
        nonlocal steps
        if len(a) <= 1:
            return a
        pivot, rest = a[0], a[1:]
        steps += len(rest)
        return sort([x for x in rest if x < pivot]) + [pivot] + sort([x for x in rest if x >= pivot])

    return sort(values[:]), steps


def main():
    values = random.sample(range(1, 40), 8)
    for name, fn in (("Bubble sort", bubble), ("Insertion sort", insertion), ("Quicksort", quick)):
        print(f"\n{name}")
        draw(values, "start")
        result, steps = fn(values)
        draw(result, f"done in {steps} comparisons")


if __name__ == "__main__":
    main()

=== binary-search | Binary Search | Algorithms | magnifyingglass.circle.fill | Find a number in a sorted list by halving the search each step.
--- main.py
"""Binary search, shown step by step, compared with checking every item."""


def binary_search(items, target):
    low, high, steps = 0, len(items) - 1, 0
    while low <= high:
        mid = (low + high) // 2
        steps += 1
        print(f"  step {steps}: looking at position {mid} (value {items[mid]}) between {low} and {high}")
        if items[mid] == target:
            return mid, steps
        if items[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    return -1, steps


def main():
    items = list(range(3, 300, 3))
    text = input(f"Number to find in {len(items)} sorted numbers (3, 6, 9 … 297) [201]: ").strip()
    target = int(text) if text.lstrip("-").isdigit() else 201
    position, steps = binary_search(items, target)
    print(f"Found at position {position}." if position >= 0 else "Not in the list.")
    print(f"Binary search took {steps} steps; checking one by one could take {len(items)}.")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print(binary_search(list(range(3, 300, 3)), 201))

=== fibonacci | Fibonacci Three Ways | Algorithms | function | Slow recursion, fast memoization and a generator, timed side by side.
--- main.py
"""Three ways to compute Fibonacci numbers, and why one of them is painfully slow."""
import time
from functools import lru_cache


def fib_slow(n):
    return n if n < 2 else fib_slow(n - 1) + fib_slow(n - 2)


@lru_cache(maxsize=None)
def fib_memo(n):
    return n if n < 2 else fib_memo(n - 1) + fib_memo(n - 2)


def fib_stream():
    a, b = 0, 1
    while True:
        yield a
        a, b = b, a + b


def timed(fn, n):
    start = time.perf_counter()
    result = fn(n)
    return result, (time.perf_counter() - start) * 1000


def main():
    n = 24
    for name, fn in (("plain recursion", fib_slow), ("with a cache", fib_memo)):
        result, ms = timed(fn, n)
        print(f"fib({n}) = {result}  {name:<16} {ms:8.3f} ms")
    stream = fib_stream()
    print("First 15:", [next(stream) for _ in range(15)])
    print("fib(200) with the cache:", fib_memo(200))


if __name__ == "__main__":
    main()

=== prime-sieve | Prime Numbers | Algorithms | number.circle.fill | Find every prime up to a limit with the Sieve of Eratosthenes.
--- main.py
"""Find primes with the Sieve of Eratosthenes, and split a number into prime factors."""


def sieve(limit):
    is_prime = [True] * (limit + 1)
    is_prime[0:2] = [False, False]
    for n in range(2, int(limit ** 0.5) + 1):
        if is_prime[n]:
            for multiple in range(n * n, limit + 1, n):
                is_prime[multiple] = False
    return [n for n, prime in enumerate(is_prime) if prime]


def factors(n):
    out, d = [], 2
    while d * d <= n:
        while n % d == 0:
            out.append(d)
            n //= d
        d += 1
    return out + ([n] if n > 1 else [])


def main():
    text = input("Find primes up to [100]: ").strip()
    limit = min(int(text), 1_000_000) if text.isdigit() and int(text) >= 2 else 100
    primes = sieve(limit)
    print(f"{len(primes)} primes up to {limit}:")
    print(primes if len(primes) <= 60 else f"{primes[:30]} … {primes[-5:]}")
    print(f"Prime factors of {limit}: {factors(limit)}")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print(sieve(100))

=== maze-solver | Maze Solver | Algorithms | arrow.triangle.turn.up.right.diamond.fill | Find the shortest path through a maze with breadth-first search.
--- main.py
"""Solve a maze with breadth-first search. Edit MAZE: # wall, S start, E end."""
from collections import deque

MAZE = """
##########
#S   #   #
# ## # # #
# #    # #
# #### # #
#    #   #
#### # ###
#      E #
##########
""".strip().splitlines()


def find(char):
    for r, row in enumerate(MAZE):
        if char in row:
            return r, row.index(char)


def solve():
    start, end = find("S"), find("E")
    came_from, queue = {start: None}, deque([start])
    while queue:
        spot = queue.popleft()
        if spot == end:
            path = []
            while spot:
                path.append(spot)
                spot = came_from[spot]
            return path[::-1]
        r, c = spot
        for nxt in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):
            if MAZE[nxt[0]][nxt[1]] != "#" and nxt not in came_from:
                came_from[nxt] = spot
                queue.append(nxt)
    return None


def main():
    path = solve()
    if not path:
        print("No way through!")
        return
    steps = set(path[1:-1])
    for r, row in enumerate(MAZE):
        print("".join("•" if (r, c) in steps else ch for c, ch in enumerate(row)))
    print(f"\nShortest path: {len(path) - 1} steps")


if __name__ == "__main__":
    main()

=== n-queens | N-Queens Puzzle | Algorithms | crown.fill | Place queens on a chessboard so none can attack another (backtracking).
--- main.py
"""Place N queens on an N×N board so that none attack each other."""


def solve(n):
    solutions, cols = [], []

    def safe(row, col):
        return all(c != col and abs(c - col) != row - r for r, c in enumerate(cols))

    def place(row):
        if row == n:
            solutions.append(cols[:])
            return
        for col in range(n):
            if safe(row, col):
                cols.append(col)
                place(row + 1)
                cols.pop()

    place(0)
    return solutions


def draw(cols):
    for col in cols:
        print(" ".join("♛" if c == col else "·" for c in range(len(cols))))


def main():
    text = input("Board size 4-9 [6]: ").strip()
    n = int(text) if text.isdigit() and 4 <= int(text) <= 9 else 6
    solutions = solve(n)
    print(f"{len(solutions)} ways to place {n} queens. Here's the first:\n")
    draw(solutions[0])


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        draw(solve(6)[0])

=== sudoku-solver | Sudoku Solver | Algorithms | square.grid.3x3.topleft.filled | Solve any sudoku puzzle in a blink with backtracking.
--- main.py
"""Solve a sudoku. Edit PUZZLE (0 means empty) and run again."""

PUZZLE = [
    "530070000", "600195000", "098000060",
    "800060003", "400803001", "700020006",
    "060000280", "000419005", "000080079",
]


def options(grid, r, c):
    used = set(grid[r]) | {grid[i][c] for i in range(9)}
    br, bc = r // 3 * 3, c // 3 * 3
    used |= {grid[br + i][bc + j] for i in range(3) for j in range(3)}
    return [d for d in range(1, 10) if d not in used]


def solve(grid):
    for r in range(9):
        for c in range(9):
            if grid[r][c] == 0:
                for digit in options(grid, r, c):
                    grid[r][c] = digit
                    if solve(grid):
                        return True
                    grid[r][c] = 0
                return False
    return True


def draw(grid):
    for r, row in enumerate(grid):
        if r % 3 == 0 and r:
            print("------+-------+------")
        print(" | ".join(" ".join(str(d or "·") for d in row[i:i + 3]) for i in (0, 3, 6)))


def main():
    grid = [[int(ch) for ch in row] for row in PUZZLE]
    draw(grid)
    print("\nSolving…\n")
    if solve(grid):
        draw(grid)
    else:
        print("This puzzle has no solution.")


if __name__ == "__main__":
    main()

=== game-of-life | Game of Life | Algorithms | circle.grid.cross.fill | Conway's famous cell simulation: simple rules, surprising patterns.
--- main.py
"""Conway's Game of Life. A cell lives with 2-3 neighbours and is born with exactly 3."""
import time

WIDTH, HEIGHT = 24, 10
GLIDER = {(1, 0), (2, 1), (0, 2), (1, 2), (2, 2)}
BLINKER = {(12, 4), (13, 4), (14, 4)}


def step(alive):
    counts = {}
    for x, y in alive:
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                if dx or dy:
                    spot = ((x + dx) % WIDTH, (y + dy) % HEIGHT)
                    counts[spot] = counts.get(spot, 0) + 1
    return {spot for spot, n in counts.items() if n == 3 or (n == 2 and spot in alive)}


def draw(alive, generation):
    print(f"Generation {generation}")
    for y in range(HEIGHT):
        print("".join("█" if (x, y) in alive else "·" for x in range(WIDTH)))
    print()


def main():
    alive = GLIDER | BLINKER
    for generation in range(8):
        draw(alive, generation)
        alive = step(alive)
        time.sleep(0.15)


if __name__ == "__main__":
    main()

=== tower-of-hanoi | Tower of Hanoi | Algorithms | square.stack.3d.up.fill | Move a stack of discs between pegs using recursion.
--- main.py
"""Solve the Tower of Hanoi and draw every move."""


def draw(pegs, discs):
    for level in range(discs - 1, -1, -1):
        row = []
        for peg in pegs:
            size = peg[level] if level < len(peg) else 0
            row.append(("█" * (size * 2 - 1) if size else "|").center(discs * 2 + 1))
        print("".join(row))
    print("".join(name.center(discs * 2 + 1) for name in "ABC") + "\n")


def hanoi(n, source, target, spare, pegs, discs, moves):
    if n == 0:
        return
    hanoi(n - 1, source, spare, target, pegs, discs, moves)
    pegs[target].append(pegs[source].pop())
    moves.append((source, target))
    print(f"Move {len(moves)}: {'ABC'[source]} → {'ABC'[target]}")
    draw(pegs, discs)
    hanoi(n - 1, spare, target, source, pegs, discs, moves)


def main():
    text = input("Discs 1-5 [3]: ").strip()
    discs = int(text) if text.isdigit() and 1 <= int(text) <= 5 else 3
    pegs, moves = [list(range(discs, 0, -1)), [], []], []
    draw(pegs, discs)
    hanoi(discs, 0, 2, 1, pegs, discs, moves)
    print(f"Solved in {len(moves)} moves (the minimum is 2^{discs} - 1 = {2 ** discs - 1}).")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nBye!")

=== bank-account | Bank Account (Classes) | Learn Python | building.columns.fill | Classes, properties and custom errors with a simple bank.
--- main.py
"""Classes in practice: accounts that deposit, withdraw and transfer."""


class InsufficientFunds(Exception):
    pass


class Account:
    def __init__(self, owner, balance=0.0):
        self.owner = owner
        self._balance = balance
        self.history = []

    @property
    def balance(self):
        return self._balance

    def deposit(self, amount):
        if amount <= 0:
            raise ValueError("Deposit must be more than zero.")
        self._balance += amount
        self.history.append(("deposit", amount))

    def withdraw(self, amount):
        if amount > self._balance:
            raise InsufficientFunds(f"{self.owner} only has ${self._balance:.2f}.")
        self._balance -= amount
        self.history.append(("withdraw", amount))

    def transfer(self, other, amount):
        self.withdraw(amount)
        other.deposit(amount)

    def __repr__(self):
        return f"Account({self.owner!r}, ${self._balance:.2f})"


class SavingsAccount(Account):
    rate = 0.04

    def add_interest(self):
        self.deposit(round(self.balance * self.rate, 2))


def main():
    ada, bob = Account("Ada", 100), SavingsAccount("Bob", 500)
    ada.deposit(50)
    bob.transfer(ada, 120)
    bob.add_interest()
    print(ada, bob)
    try:
        ada.withdraw(1000)
    except InsufficientFunds as e:
        print("Refused:", e)
    print("Ada's history:", ada.history)


if __name__ == "__main__":
    main()

=== dataclasses-inventory | Inventory (Dataclasses) | Learn Python | shippingbox.fill | Tidy data objects with dataclasses, sorting and totals.
--- main.py
"""Dataclasses give you tidy objects with almost no code."""
from dataclasses import dataclass, field


@dataclass(order=True)
class Item:
    name: str
    price: float
    quantity: int = 0
    tags: list = field(default_factory=list)

    @property
    def value(self):
        return self.price * self.quantity


@dataclass
class Inventory:
    items: dict = field(default_factory=dict)

    def add(self, item):
        if item.name in self.items:
            self.items[item.name].quantity += item.quantity
        else:
            self.items[item.name] = item

    def low_stock(self, below=5):
        return [i for i in self.items.values() if i.quantity < below]

    def total(self):
        return sum(i.value for i in self.items.values())


def main():
    stock = Inventory()
    for item in (Item("mango", 1.5, 40, ["fruit"]), Item("lime", 0.3, 3, ["fruit"]),
                 Item("blender", 49.0, 2, ["kitchen"]), Item("mango", 1.5, 10)):
        stock.add(item)
    for item in sorted(stock.items.values(), key=lambda i: -i.value):
        print(f"{item.name:<10} {item.quantity:>3} × ${item.price:<6.2f} = ${item.value:>7.2f}  {item.tags}")
    print(f"\nTotal value: ${stock.total():.2f}")
    print("Low stock:", [i.name for i in stock.low_stock()])
    print("Printing an item:", stock.items["lime"])


if __name__ == "__main__":
    main()

=== decorators | Decorators | Learn Python | wand.and.stars | Wrap functions to time them, retry them and cache their results.
--- main.py
"""Decorators add behaviour to functions without changing them."""
import functools
import random
import time


def timed(fn):
    @functools.wraps(fn)
    def wrapper(*args, **kwargs):
        start = time.perf_counter()
        result = fn(*args, **kwargs)
        print(f"  ⏱ {fn.__name__} took {(time.perf_counter() - start) * 1000:.2f} ms")
        return result
    return wrapper


def retry(times):
    def decorator(fn):
        @functools.wraps(fn)
        def wrapper(*args, **kwargs):
            for attempt in range(1, times + 1):
                try:
                    return fn(*args, **kwargs)
                except RuntimeError as e:
                    print(f"  attempt {attempt} failed: {e}")
            raise RuntimeError(f"{fn.__name__} failed {times} times")
        return wrapper
    return decorator


@timed
def slow_sum(n):
    return sum(i * i for i in range(n))


@retry(times=5)
def flaky():
    if random.random() < 0.6:
        raise RuntimeError("network hiccup")
    return "success"


def main():
    print("slow_sum:", slow_sum(200_000))
    random.seed(7)
    print("flaky:", flaky())


if __name__ == "__main__":
    main()

=== generators | Generators & Pipelines | Learn Python | arrow.triangle.branch | Process data one item at a time without loading it all into memory.
--- main.py
"""Generators produce values one at a time, so you can chain steps like a pipeline."""
import itertools


def numbers(start=1):
    while True:
        yield start
        start += 1


def only(predicate, stream):
    for item in stream:
        if predicate(item):
            yield item


def squares(stream):
    for item in stream:
        yield item * item


def chunks(stream, size):
    while batch := list(itertools.islice(stream, size)):
        yield batch


def main():
    evens = only(lambda n: n % 2 == 0, numbers())
    pipeline = squares(evens)
    print("First 8 even squares:", list(itertools.islice(pipeline, 8)))
    print("In batches of 4:", list(chunks(iter(range(10)), 4)))
    words = ["mango", "kiwi", "fig", "banana", "plum"]
    print("Generator expression:", sum(len(w) for w in words), "letters in total")
    print("Longest first:", sorted(words, key=len, reverse=True))


if __name__ == "__main__":
    main()

=== asyncio-demo | Async Tasks (asyncio) | Learn Python | bolt.horizontal.fill | Run several slow jobs at once instead of one after another.
--- main.py
"""asyncio runs waiting jobs side by side. Three 'downloads' finish in the time of the longest one."""
import asyncio
import time


async def download(name, seconds):
    print(f"  start  {name}")
    await asyncio.sleep(seconds)
    print(f"  finish {name} after {seconds}s")
    return f"{name}.zip"


async def one_by_one(jobs):
    return [await download(name, s) for name, s in jobs]


async def all_at_once(jobs):
    return await asyncio.gather(*(download(name, s) for name, s in jobs))


async def main():
    jobs = [("photos", 0.6), ("music", 0.4), ("docs", 0.2)]
    for label, runner in (("One by one", one_by_one), ("All at once", all_at_once)):
        print(label)
        start = time.perf_counter()
        files = await runner(jobs)
        print(f"  got {files} in {time.perf_counter() - start:.1f}s\n")


if __name__ == "__main__":
    asyncio.run(main())

