        main()
    except (EOFError, KeyboardInterrupt, ValueError):
        print("\nBye!")

=== countdown | Countdown Timer | Starter | timer | A ticking countdown with a progress bar.
--- main.py
"""Count down from a number of seconds with a progress bar."""
import time


def bar(done, total, width=20):
    filled = round(width * done / total)
    return "█" * filled + "░" * (width - filled)


def countdown(seconds, tick=1.0):
    for left in range(seconds, 0, -1):
        print(f"{bar(seconds - left, seconds)} {left:>3}s left")
        time.sleep(tick)
    print(f"{bar(1, 1)} Time's up! ⏰")


def main():
    text = input("Seconds to count down [5]: ").strip()
    countdown(int(text) if text.isdigit() else 5)


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        countdown(3, tick=0.2)

