"""Rock, paper, scissors: first to 3 wins."""
import random

BEATS = {"rock": "scissors", "paper": "rock", "scissors": "paper"}
SHORT = {"r": "rock", "p": "paper", "s": "scissors"}


def main():
    you = cpu = 0
    while you < 3 and cpu < 3:
        pick = SHORT.get(input("rock, paper or scissors (r/p/s)? ").strip().lower()[:1])
        if not pick:
            print("Type r, p or s.")
            continue
        other = random.choice(list(BEATS))
        if pick == other:
            result = "Draw."
        elif BEATS[pick] == other:
            you += 1
            result = "You win the round!"
        else:
            cpu += 1
            result = "Computer wins the round."
        print(f"You: {pick}  Computer: {other}  →  {result}  [{you}-{cpu}]")
    print("🏆 You won the match!" if you > cpu else "Computer takes the match.")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
