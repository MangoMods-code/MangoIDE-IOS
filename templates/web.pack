--- script.js
const form = document.getElementById("form");

// Each rule returns an error message, or "" when the field is fine.
const RULES = {
  name: (v) => (v.trim().length < 2 ? "Please enter your name." : ""),
  email: (v) => (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v) ? "" : "That doesn't look like an email address."),
  password: (v) => (v.length < 8 ? "Use at least 8 characters." : !/\d/.test(v) ? "Add at least one number." : ""),
  confirm: (v) => (v !== form.password.value ? "The passwords don't match." : v ? "" : "Type your password again."),
  terms: (_, field) => (field.checked ? "" : "You need to agree to continue."),
};

function check(field) {
  const message = RULES[field.name](field.value, field);
  const label = field.closest("label");
  label.classList.toggle("invalid", Boolean(message));
  label.classList.toggle("valid", !message);
  label.querySelector("small").textContent = message;
  return !message;
}

form.addEventListener("input", (event) => {
  if (!(event.target.name in RULES)) return;
  check(event.target);
  if (event.target.name === "password" && form.confirm.value) check(form.confirm);
  document.getElementById("done").hidden = true;
});

form.addEventListener("submit", (event) => {
  event.preventDefault();
  const results = Object.keys(RULES).map((name) => check(form[name]));
  const ok = results.every(Boolean);
  document.getElementById("done").hidden = !ok;
  if (!ok) form.querySelector(".invalid input").focus();
});

=== tic-tac-toe | Tic-Tac-Toe | Games | number.square.fill | Two players on one screen, with win detection and a running score.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tic-Tac-Toe</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <p id="status"></p>
    <div id="board"></div>
    <div class="score"><span>✕ <b id="scoreX">0</b></span><span>Draws <b id="scoreD">0</b></span><span>◯ <b id="scoreO">0</b></span></div>
    <button id="again">New game</button>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { width: 100%; max-width: 340px; padding: 16px; text-align: center; }
#status { margin: 0 0 14px; font-size: 1.2rem; font-weight: 700; }
#board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
#board button { aspect-ratio: 1; border: 0; border-radius: 16px; background: #211e2e; font-size: 3rem; font-weight: 700; color: #ffb347; touch-action: manipulation; transition: background 0.2s, transform 0.1s; }
#board button.o { color: #7cc4ff; }
#board button.win { background: #2f5a3d; transform: scale(1.04); }
#board button:disabled { opacity: 1; }
.score { display: flex; justify-content: space-between; margin: 16px 4px; color: #a39fb3; }
.score b { color: #f1eef7; }
#again { width: 100%; padding: 13px; border: 0; border-radius: 14px; font: inherit; font-weight: 700; background: #ff9a1a; color: #1a1300; }
--- script.js
const LINES = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
const board = document.getElementById("board");
const status = document.getElementById("status");
const score = { X: 0, O: 0, D: 0 };
let cells, player, over, starter = "O";

function start() {
  cells = Array(9).fill("");
  starter = starter === "X" ? "O" : "X";           // take turns going first
  player = starter;
  over = false;
  board.innerHTML = "";
  for (let i = 0; i < 9; i++) {
    const b = document.createElement("button");
    b.addEventListener("click", () => play(i));
    board.appendChild(b);
  }
  status.textContent = `${symbol(player)} goes first`;
}

const symbol = (p) => (p === "X" ? "✕" : "◯");

function play(i) {
  if (over || cells[i]) return;
  cells[i] = player;
  const button = board.children[i];
  button.textContent = symbol(player);
  button.classList.toggle("o", player === "O");
  const line = LINES.find(([a, b, c]) => cells[a] && cells[a] === cells[b] && cells[b] === cells[c]);
  if (line) {
    for (const index of line) board.children[index].classList.add("win");
    finish(player, `${symbol(player)} wins! 🎉`);
  } else if (cells.every(Boolean)) {
    finish("D", "It's a draw.");
  } else {
    player = player === "X" ? "O" : "X";
    status.textContent = `${symbol(player)}'s turn`;
  }
}

function finish(key, message) {
  over = true;
  score[key]++;
  status.textContent = message;
  for (const k of ["X", "O", "D"]) document.getElementById("score" + k).textContent = score[k];
}

document.getElementById("again").addEventListener("click", start);
start();

=== memory-match | Memory Match | Games | square.on.square.fill | Flip cards to find the pairs. Counts your moves and remembers your best game.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Memory Match</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <header><span>Moves <b id="moves">0</b></span><span>Best <b id="best">–</b></span><button id="restart">Restart</button></header>
    <div id="grid"></div>
    <p id="message"></p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 400px; margin: 0 auto; padding: 16px; }
header { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; color: #a39fb3; }
header b { color: #f1eef7; }
header button { margin-left: auto; padding: 8px 14px; border: 0; border-radius: 10px; font: inherit; background: #2f2b40; color: #f1eef7; }
#grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; perspective: 800px; }
.card { aspect-ratio: 3 / 4; position: relative; border: 0; padding: 0; background: none; transform-style: preserve-3d; transition: transform 0.35s; touch-action: manipulation; }
.card.up { transform: rotateY(180deg); }
.card span { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 12px; backface-visibility: hidden; -webkit-backface-visibility: hidden; font-size: 2rem; }
.card .back { background: linear-gradient(135deg, #ff9a1a, #ff5e62); }
.card .front { background: #2a2636; transform: rotateY(180deg); }
.card.matched .front { background: #1f4d33; }
#message { text-align: center; min-height: 1.4em; margin-top: 14px; font-weight: 700; color: #5ee08a; }
--- script.js
const EMOJI = ["🥭", "🍋", "🍓", "🥝", "🍇", "🍉", "🍍", "🥥"];
const grid = document.getElementById("grid");
let open = [], moves = 0, matched = 0, locked = false;

const best = {
  get() { try { return Number(localStorage.getItem("memory-best")) || null; } catch (e) { return null; } },
  set(n) { try { localStorage.setItem("memory-best", n); } catch (e) {} },
};

function shuffle(list) {
  for (let i = list.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [list[i], list[j]] = [list[j], list[i]];
  }
  return list;
}

function start() {
  open = []; moves = 0; matched = 0; locked = false;
  grid.innerHTML = "";
  document.getElementById("moves").textContent = 0;
  document.getElementById("best").textContent = best.get() || "–";
  document.getElementById("message").textContent = "";
  for (const emoji of shuffle([...EMOJI, ...EMOJI])) {
    const card = document.createElement("button");
    card.className = "card";
    card.dataset.emoji = emoji;
    card.innerHTML = `<span class="back"></span><span class="front">${emoji}</span>`;
    card.addEventListener("click", () => flip(card));
    grid.appendChild(card);
  }
}

function flip(card) {
  if (locked || card.classList.contains("up")) return;
  card.classList.add("up");
  open.push(card);
  if (open.length < 2) return;
  document.getElementById("moves").textContent = ++moves;
  const [a, b] = open;
  open = [];
  if (a.dataset.emoji === b.dataset.emoji) {
    a.classList.add("matched"); b.classList.add("matched");
    if (++matched === EMOJI.length) {
      const record = !best.get() || moves < best.get();
      if (record) best.set(moves);
      document.getElementById("message").textContent = `Done in ${moves} moves!${record ? " New best 🏆" : ""}`;
      document.getElementById("best").textContent = best.get() || moves;
    }
  } else {
    locked = true;
    setTimeout(() => { a.classList.remove("up"); b.classList.remove("up"); locked = false; }, 700);
  }
}

document.getElementById("restart").addEventListener("click", start);
start();

=== snake | Snake | Games | arrow.up.and.down.and.arrow.left.and.right | The classic on a canvas. Swipe or use the arrow buttons to steer.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Snake</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <header><span>Score <b id="score">0</b></span><span>Best <b id="best">0</b></span></header>
    <canvas id="game" width="320" height="320"></canvas>
    <p id="message">Swipe or tap an arrow to start</p>
    <div class="pad">
      <button data-dir="up">▲</button>
      <button data-dir="left">◀</button><button data-dir="down">▼</button><button data-dir="right">▶</button>
    </div>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; overscroll-behavior: none; }
main { max-width: 352px; margin: 0 auto; padding: 14px 16px; text-align: center; }
header { display: flex; justify-content: space-between; margin-bottom: 10px; color: #a39fb3; }
header b { color: #f1eef7; }
canvas { width: 100%; aspect-ratio: 1; border-radius: 16px; background: #1c1926; touch-action: none; }
#message { min-height: 1.3em; margin: 10px 0; color: #a39fb3; font-size: 0.9rem; }
.pad { display: grid; grid-template-columns: repeat(3, 62px); gap: 8px; justify-content: center; }
.pad button { height: 54px; border: 0; border-radius: 14px; background: #2f2b40; color: #f1eef7; font-size: 1.1rem; touch-action: manipulation; }
.pad button:first-child { grid-column: 2; }
.pad button:nth-child(2) { grid-column: 1; }
.pad button:active { background: #ff9a1a; color: #1a1300; }
--- script.js
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const GRID = 16, CELL = canvas.width / GRID;
const DIRS = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };

let snake, dir, nextDir, food, score, timer, best = 0;
try { best = Number(localStorage.getItem("snake-best")) || 0; } catch (e) {}
document.getElementById("best").textContent = best;

function reset() {
  snake = [[8, 8], [7, 8], [6, 8]];
  dir = nextDir = null;
  score = 0;
  placeFood();
  draw();
}

function placeFood() {
  do { food = [Math.floor(Math.random() * GRID), Math.floor(Math.random() * GRID)]; }
  while (snake.some(([x, y]) => x === food[0] && y === food[1]));
}

function steer(name) {
  const next = DIRS[name];
  if (!next) return;
  if (dir && next[0] === -dir[0] && next[1] === -dir[1]) return;      // no reversing into yourself
  nextDir = next;
  if (!timer) {
    document.getElementById("message").textContent = "";
    if (!dir && name === "left") nextDir = DIRS.up;                     // the snake starts facing right
    timer = setInterval(step, 130);
  }
}

function step() {
  dir = nextDir;
  const head = [snake[0][0] + dir[0], snake[0][1] + dir[1]];
  const hitWall = head[0] < 0 || head[1] < 0 || head[0] >= GRID || head[1] >= GRID;
  if (hitWall || snake.some(([x, y]) => x === head[0] && y === head[1])) return gameOver();
  snake.unshift(head);
  if (head[0] === food[0] && head[1] === food[1]) { score++; placeFood(); } else snake.pop();
  document.getElementById("score").textContent = score;
  draw();
}

function gameOver() {
  clearInterval(timer);
  timer = null;
  if (score > best) { best = score; try { localStorage.setItem("snake-best", best); } catch (e) {} }
  document.getElementById("best").textContent = best;
  document.getElementById("message").textContent = `Game over: ${score} points. Swipe to play again.`;
  reset();
  document.getElementById("score").textContent = 0;
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.fillStyle = "#ff5e62";
  ctx.beginPath();
  ctx.arc((food[0] + 0.5) * CELL, (food[1] + 0.5) * CELL, CELL * 0.38, 0, Math.PI * 2);
  ctx.fill();
  snake.forEach(([x, y], i) => {
    ctx.fillStyle = i === 0 ? "#ffb347" : "#5ee08a";
    ctx.beginPath();
    ctx.roundRect(x * CELL + 1, y * CELL + 1, CELL - 2, CELL - 2, 5);
    ctx.fill();
  });
}

document.querySelector(".pad").addEventListener("click", (event) => steer(event.target.dataset.dir));
document.addEventListener("keydown", (event) => steer(event.key.replace("Arrow", "").toLowerCase()));

let touch = null;
canvas.addEventListener("pointerdown", (event) => { touch = [event.clientX, event.clientY]; });
canvas.addEventListener("pointerup", (event) => {
  if (!touch) return;
  const dx = event.clientX - touch[0], dy = event.clientY - touch[1];
  touch = null;
  if (Math.max(Math.abs(dx), Math.abs(dy)) < 16) return;
  steer(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? "right" : "left") : dy > 0 ? "down" : "up");
});

reset();

=== whack-a-mole | Whack-a-Mole | Games | hammer.fill | Tap the moles before they hide. Thirty seconds, and it speeds up.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Whack-a-Mole</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <header><span>Score <b id="score">0</b></span><span>Time <b id="time">30</b></span></header>
    <div id="field"></div>
    <button id="start">Start</button>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #1d3320; color: #f1eef7; }
main { max-width: 380px; margin: 0 auto; padding: 16px; text-align: center; }
header { display: flex; justify-content: space-between; font-size: 1.1rem; margin-bottom: 14px; }
#field { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.hole { aspect-ratio: 1; position: relative; overflow: hidden; border-radius: 50%; background: radial-gradient(circle at 50% 70%, #1a120a, #3a2a17); border: 0; padding: 0; touch-action: manipulation; }
.hole span { position: absolute; left: 0; right: 0; bottom: -70%; font-size: 3.2rem; transition: bottom 0.12s ease-out; }
.hole.up span { bottom: 12%; }
.hole.hit span { transform: scale(0.8) rotate(20deg); filter: grayscale(1); }
#start { margin-top: 18px; width: 100%; padding: 14px; border: 0; border-radius: 14px; font: inherit; font-weight: 700; background: #ffb347; color: #1a1300; }
#start:disabled { opacity: 0.5; }
--- script.js
const field = document.getElementById("field");
const startButton = document.getElementById("start");
let score = 0, timeLeft = 30, playing = false, moleTimer, clock;

for (let i = 0; i < 9; i++) {
  const hole = document.createElement("button");
  hole.className = "hole";
  hole.innerHTML = "<span>🐹</span>";
  hole.addEventListener("pointerdown", () => whack(hole));
  field.appendChild(hole);
}
const holes = [...field.children];

function popUp() {
  if (!playing) return;
  const free = holes.filter((h) => !h.classList.contains("up"));
  const hole = free[Math.floor(Math.random() * free.length)];
  hole.classList.remove("hit");
  hole.classList.add("up");
  const speed = 450 + timeLeft * 18;               // moles hide faster as time runs out
  setTimeout(() => hole.classList.remove("up"), speed);
  moleTimer = setTimeout(popUp, speed * 0.6 + Math.random() * 300);
}

function whack(hole) {
  if (!playing || !hole.classList.contains("up") || hole.classList.contains("hit")) return;
  hole.classList.add("hit");
  document.getElementById("score").textContent = ++score;
  setTimeout(() => hole.classList.remove("up"), 120);
}

startButton.addEventListener("click", () => {
  score = 0; timeLeft = 30; playing = true;
  document.getElementById("score").textContent = 0;
  document.getElementById("time").textContent = 30;
  startButton.disabled = true;
  popUp();
  clock = setInterval(() => {
    document.getElementById("time").textContent = --timeLeft;
    if (timeLeft > 0) return;
    playing = false;
    clearInterval(clock);
    clearTimeout(moleTimer);
    for (const h of holes) h.classList.remove("up");
    startButton.disabled = false;
    startButton.textContent = `You scored ${score}. Play again`;
  }, 1000);
});

=== game-2048 | 2048 | Games | square.grid.4x3.fill | Swipe to slide the tiles and merge matching numbers up to 2048.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>2048</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <header><h1>2048</h1><span>Score <b id="score">0</b></span><button id="new">New</button></header>
    <div id="board"></div>
    <p id="message">Swipe to move the tiles</p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; overscroll-behavior: none; }
main { max-width: 360px; margin: 0 auto; padding: 14px 16px; }
header { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; color: #a39fb3; }
h1 { margin: 0 auto 0 0; font-size: 1.8rem; color: #ffb347; }
header b { color: #f1eef7; }
header button { padding: 8px 14px; border: 0; border-radius: 10px; font: inherit; background: #2f2b40; color: #f1eef7; }
#board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 8px; border-radius: 16px; background: #211e2e; touch-action: none; }
.tile { aspect-ratio: 1; display: grid; place-items: center; border-radius: 10px; background: #2f2b40; font-size: 1.5rem; font-weight: 800; color: #14121c; }
.tile.new { animation: pop 0.18s ease-out; }
@keyframes pop { from { transform: scale(0.5); } }
.t2 { background: #eee4da; } .t4 { background: #ede0c8; } .t8 { background: #f2b179; } .t16 { background: #f59563; }
.t32 { background: #f67c5f; } .t64 { background: #f65e3b; } .t128 { background: #edcf72; font-size: 1.3rem; }
.t256 { background: #edcc61; font-size: 1.3rem; } .t512 { background: #edc850; font-size: 1.3rem; }
.t1024 { background: #edc53f; font-size: 1.05rem; } .t2048 { background: #5ee08a; font-size: 1.05rem; }
#message { text-align: center; color: #a39fb3; min-height: 1.3em; }
--- script.js
const boardEl = document.getElementById("board");
let grid, score, won;

function start() {
  grid = Array.from({ length: 4 }, () => Array(4).fill(0));
  score = 0; won = false;
  addTile(); addTile();
  render();
  document.getElementById("message").textContent = "Swipe to move the tiles";
}

function addTile() {
  const empty = [];
  grid.forEach((row, r) => row.forEach((v, c) => { if (!v) empty.push([r, c]); }));
  if (!empty.length) return null;
  const [r, c] = empty[Math.floor(Math.random() * empty.length)];
  grid[r][c] = Math.random() < 0.9 ? 2 : 4;
  return r * 4 + c;
}

// Slide one row to the left, merging equal neighbours once.
function slide(row) {
  const tiles = row.filter(Boolean);
  for (let i = 0; i < tiles.length - 1; i++) {
    if (tiles[i] === tiles[i + 1]) { tiles[i] *= 2; score += tiles[i]; tiles.splice(i + 1, 1); }
  }
  return tiles.concat(Array(4 - tiles.length).fill(0));
}

const transpose = (g) => g[0].map((_, c) => g.map((row) => row[c]));
const mirror = (g) => g.map((row) => [...row].reverse());

function move(direction) {
  const before = JSON.stringify(grid);
  if (direction === "left") grid = grid.map(slide);
  if (direction === "right") grid = mirror(mirror(grid).map(slide));
  if (direction === "up") grid = transpose(transpose(grid).map(slide));
  if (direction === "down") grid = transpose(mirror(mirror(transpose(grid)).map(slide)));
  if (JSON.stringify(grid) === before) return;
  render(addTile());
  const flat = grid.flat();
  if (!won && flat.includes(2048)) { won = true; document.getElementById("message").textContent = "2048! 🎉 Keep going if you like."; }
  else if (!canMove()) document.getElementById("message").textContent = "No moves left. Tap New to try again.";
}

function canMove() {
  for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) {
    if (!grid[r][c]) return true;
    if (c < 3 && grid[r][c] === grid[r][c + 1]) return true;
    if (r < 3 && grid[r][c] === grid[r + 1][c]) return true;
  }
  return false;
}

function render(newIndex) {
  boardEl.innerHTML = "";
  grid.flat().forEach((value, i) => {
    const tile = document.createElement("div");
    tile.className = "tile" + (value ? ` t${Math.min(value, 2048)}` : "") + (i === newIndex ? " new" : "");
    tile.textContent = value || "";
    boardEl.appendChild(tile);
  });
  document.getElementById("score").textContent = score;
}

let touch = null;
boardEl.addEventListener("pointerdown", (event) => { touch = [event.clientX, event.clientY]; });
boardEl.addEventListener("pointerup", (event) => {
  if (!touch) return;
  const dx = event.clientX - touch[0], dy = event.clientY - touch[1];
  touch = null;
  if (Math.max(Math.abs(dx), Math.abs(dy)) < 20) return;
  move(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? "right" : "left") : dy > 0 ? "down" : "up");
});
document.addEventListener("keydown", (event) => { if (event.key.startsWith("Arrow")) move(event.key.slice(5).toLowerCase()); });
document.getElementById("new").addEventListener("click", start);
start();

=== reaction-test | Reaction Time Test | Games | bolt.fill | Tap the moment the screen turns green and see how fast you are.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Reaction Test</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <button id="pad" class="idle">
    <strong id="title">Reaction Test</strong>
    <span id="detail">Tap to start. Then tap again as soon as it turns green.</span>
    <small id="stats"></small>
  </button>
  <script src="script.js"></script>
</body>
</html>
--- style.css
html, body { height: 100%; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; }
#pad { width: 100%; height: 100%; min-height: 360px; border: 0; padding: 24px; display: grid; place-content: center; gap: 10px; text-align: center; color: #fff; font: inherit; touch-action: manipulation; transition: background 0.1s; }
#pad strong { font-size: 2.6rem; font-weight: 800; }
#pad span { font-size: 1.05rem; opacity: 0.9; max-width: 26ch; margin: 0 auto; }
#pad small { margin-top: 16px; font-size: 0.9rem; opacity: 0.8; min-height: 1.2em; }
.idle { background: #2c5282; }
.waiting { background: #9b2c2c; }
.go { background: #2f855a; }
.early { background: #744210; }
--- script.js
const pad = document.getElementById("pad");
const title = document.getElementById("title");
const detail = document.getElementById("detail");
const stats = document.getElementById("stats");
let state = "idle", timer, shownAt;
const times = [];

function set(newState, heading, text) {
  state = newState;
  pad.className = newState;
  title.textContent = heading;
  detail.textContent = text;
}

pad.addEventListener("pointerdown", () => {
  if (state === "idle" || state === "result" || state === "early") {
    set("waiting", "Wait…", "Tap when the screen turns green.");
    timer = setTimeout(() => {
      shownAt = performance.now();
      set("go", "Tap!", "");
    }, 1200 + Math.random() * 2800);
  } else if (state === "waiting") {
    clearTimeout(timer);
    set("early", "Too soon!", "Wait for green. Tap to try again.");
  } else if (state === "go") {
    const ms = Math.round(performance.now() - shownAt);
    times.push(ms);
    const average = Math.round(times.reduce((a, b) => a + b, 0) / times.length);
    const verdict = ms < 220 ? "Lightning ⚡️" : ms < 300 ? "Quick!" : ms < 400 ? "Average" : "Sleepy 😴";
    set("result", `${ms} ms`, `${verdict} Tap to go again.`);
    pad.className = "idle";
    stats.textContent = `Best ${Math.min(...times)} ms · Average ${average} ms · ${times.length} tries`;
  }
});

=== drawing-pad | Drawing Pad | Canvas | scribble.variable | Draw with your finger: pick a color and brush size, undo strokes and clear.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Drawing Pad</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="tools">
    <div id="colors"></div>
    <input id="size" type="range" min="2" max="30" value="6" aria-label="Brush size">
    <button id="undo">Undo</button><button id="clear">Clear</button>
  </div>
  <canvas id="pad"></canvas>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
html, body { height: 100%; }
body { margin: 0; display: flex; flex-direction: column; font-family: -apple-system, system-ui, sans-serif; background: #14121c; overscroll-behavior: none; }
.tools { display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: #211e2e; }
#colors { display: flex; gap: 6px; }
#colors button { width: 26px; height: 26px; border-radius: 50%; border: 2px solid transparent; padding: 0; }
#colors button.on { border-color: #fff; transform: scale(1.15); }
#size { flex: 1; min-width: 50px; accent-color: #ff9a1a; }
.tools > button { padding: 7px 11px; border: 0; border-radius: 9px; font: inherit; font-size: 0.85rem; background: #2f2b40; color: #f1eef7; }
canvas { flex: 1; width: 100%; min-height: 260px; background: #fdfcff; touch-action: none; }
--- script.js
const canvas = document.getElementById("pad");
const ctx = canvas.getContext("2d");
const COLORS = ["#14121c", "#ff5e62", "#ff9a1a", "#5ee08a", "#3b9cff", "#8e6bff"];
let color = COLORS[0], strokes = [], current = null;

// Match the canvas to its size on screen, sharp on high-resolution displays.
function resize() {
  const ratio = window.devicePixelRatio || 1;
  canvas.width = canvas.clientWidth * ratio;
  canvas.height = canvas.clientHeight * ratio;
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
  redraw();
}

function drawStroke(stroke) {
  ctx.strokeStyle = stroke.color;
  ctx.lineWidth = stroke.size;
  ctx.lineCap = ctx.lineJoin = "round";
  ctx.beginPath();
  stroke.points.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));
  if (stroke.points.length === 1) ctx.lineTo(stroke.points[0][0] + 0.01, stroke.points[0][1]);   // a dot
  ctx.stroke();
}

function redraw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  strokes.forEach(drawStroke);
}

const point = (event) => { const r = canvas.getBoundingClientRect(); return [event.clientX - r.left, event.clientY - r.top]; };

canvas.addEventListener("pointerdown", (event) => {
  canvas.setPointerCapture(event.pointerId);
  current = { color, size: Number(document.getElementById("size").value), points: [point(event)] };
  strokes.push(current);
  drawStroke(current);
});
canvas.addEventListener("pointermove", (event) => {
  if (!current) return;
  current.points.push(point(event));
  redraw();
});
for (const type of ["pointerup", "pointercancel"]) canvas.addEventListener(type, () => { current = null; });

const colorsEl = document.getElementById("colors");
COLORS.forEach((c, i) => {
  const b = document.createElement("button");
  b.style.background = c;
  b.className = i === 0 ? "on" : "";
  b.setAttribute("aria-label", "Color " + c);
  b.addEventListener("click", () => {
    color = c;
    for (const other of colorsEl.children) other.classList.toggle("on", other === b);
  });
  colorsEl.appendChild(b);
});

document.getElementById("undo").addEventListener("click", () => { strokes.pop(); redraw(); });
document.getElementById("clear").addEventListener("click", () => { strokes = []; redraw(); });
window.addEventListener("resize", resize);
resize();

=== starfield | Starfield | Canvas | sparkles | Fly through space: an animated canvas of stars that follows your finger.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Starfield</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <canvas id="space"></canvas>
  <p>Drag to steer · tap to change speed</p>
  <script src="script.js"></script>
</body>
</html>
--- style.css
html, body { height: 100%; }
body { margin: 0; background: #05040a; overflow: hidden; font-family: -apple-system, system-ui, sans-serif; }
canvas { display: block; width: 100%; height: 100%; min-height: 320px; touch-action: none; }
p { position: fixed; left: 0; right: 0; bottom: 14px; margin: 0; text-align: center; color: rgba(255, 255, 255, 0.45); font-size: 0.8rem; pointer-events: none; }
--- script.js
const canvas = document.getElementById("space");
const ctx = canvas.getContext("2d");
const STAR_COUNT = 260, SPEEDS = [0.004, 0.012, 0.03];
let width, height, speedIndex = 1;
const center = { x: 0.5, y: 0.5 }, target = { x: 0.5, y: 0.5 };

// Each star has a position around the middle and a depth (z): 1 is far away, 0 is right at the screen.
const newStar = (z = Math.random()) => ({ x: Math.random() * 2 - 1, y: Math.random() * 2 - 1, z, hue: 200 + Math.random() * 60 });
const stars = Array.from({ length: STAR_COUNT }, () => newStar());

function resize() {
  const ratio = window.devicePixelRatio || 1;
  width = canvas.clientWidth;
  height = canvas.clientHeight;
  canvas.width = width * ratio;
  canvas.height = height * ratio;
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
}

function frame() {
  // A see-through black layer instead of a full clear leaves short trails.
  ctx.fillStyle = "rgba(5, 4, 10, 0.35)";
  ctx.fillRect(0, 0, width, height);
  center.x += (target.x - center.x) * 0.06;
  center.y += (target.y - center.y) * 0.06;
  const speed = SPEEDS[speedIndex];
  for (const star of stars) {
    star.z -= speed;
    if (star.z <= 0.01) Object.assign(star, newStar(1));
    const x = center.x * width + (star.x / star.z) * width * 0.5;
    const y = center.y * height + (star.y / star.z) * height * 0.5;
    if (x < 0 || x > width || y < 0 || y > height) { Object.assign(star, newStar(1)); continue; }
    const size = (1 - star.z) * 2.6;
    ctx.fillStyle = `hsla(${star.hue}, 80%, ${70 + (1 - star.z) * 30}%, ${1 - star.z * 0.7})`;
    ctx.beginPath();
    ctx.arc(x, y, size, 0, Math.PI * 2);
    ctx.fill();
  }
  requestAnimationFrame(frame);
}

let moved = false;
canvas.addEventListener("pointerdown", () => { moved = false; });
canvas.addEventListener("pointermove", (event) => {
  if (event.buttons === 0 && event.pointerType === "mouse") return;
  moved = true;
  target.x = event.clientX / width;
  target.y = event.clientY / height;
});
canvas.addEventListener("pointerup", () => { if (!moved) speedIndex = (speedIndex + 1) % SPEEDS.length; });
window.addEventListener("resize", resize);
resize();
frame();

=== analog-clock | Analog Clock | Canvas | clock.fill | A ticking clock drawn with CSS and moved by a few lines of JavaScript.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Clock</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <div class="clock" id="clock">
      <div class="hand hour" id="hour"></div>
      <div class="hand minute" id="minute"></div>
      <div class="hand second" id="second"></div>
      <div class="pin"></div>
    </div>
    <p id="digital"></p>
    <p id="date"></p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { text-align: center; padding: 20px; }
.clock { position: relative; width: 240px; height: 240px; margin: 0 auto 20px; border-radius: 50%; background: radial-gradient(circle at 50% 35%, #2a2636, #1a1724); box-shadow: 0 0 0 6px #2f2b40, 0 20px 50px rgba(0, 0, 0, 0.5); }
.mark { position: absolute; left: 50%; top: 8px; width: 2px; height: 10px; margin-left: -1px; background: #6f6a85; transform-origin: 50% 112px; }
.mark.big { width: 4px; height: 16px; margin-left: -2px; background: #f1eef7; }
.hand { position: absolute; left: 50%; bottom: 50%; border-radius: 6px; transform-origin: 50% 100%; }
.hour { width: 6px; height: 62px; margin-left: -3px; background: #f1eef7; }
.minute { width: 4px; height: 92px; margin-left: -2px; background: #c5c0d6; }
.second { width: 2px; height: 100px; margin-left: -1px; background: #ff9a1a; }
.pin { position: absolute; left: 50%; top: 50%; width: 12px; height: 12px; margin: -6px; border-radius: 50%; background: #ff9a1a; }
#digital { margin: 0; font-size: 2rem; font-weight: 300; font-variant-numeric: tabular-nums; }
#date { margin: 4px 0 0; color: #a39fb3; }
--- script.js
const clock = document.getElementById("clock");

// Sixty tick marks, with a bigger one every five minutes.
for (let i = 0; i < 60; i++) {
  const mark = document.createElement("div");
  mark.className = "mark" + (i % 5 === 0 ? " big" : "");
  mark.style.transform = `rotate(${i * 6}deg)`;
  clock.prepend(mark);
}

function update() {
  const now = new Date();
  const seconds = now.getSeconds() + now.getMilliseconds() / 1000;
  const minutes = now.getMinutes() + seconds / 60;
  const hours = (now.getHours() % 12) + minutes / 60;
  document.getElementById("second").style.transform = `rotate(${seconds * 6}deg)`;
  document.getElementById("minute").style.transform = `rotate(${minutes * 6}deg)`;
  document.getElementById("hour").style.transform = `rotate(${hours * 30}deg)`;
  document.getElementById("digital").textContent = now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
  document.getElementById("date").textContent = now.toLocaleDateString([], { weekday: "long", month: "long", day: "numeric" });
  requestAnimationFrame(update);
}
update();

=== bouncing-balls | Bouncing Balls | Canvas | circle.hexagongrid.fill | A small physics toy: tap to add balls that fall, bounce and collide.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Bouncing Balls</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <canvas id="world"></canvas>
  <p>Tap to add a ball · <button id="clear">Clear</button></p>
  <script src="script.js"></script>
</body>
</html>
--- style.css
html, body { height: 100%; }
body { margin: 0; background: #14121c; overflow: hidden; font-family: -apple-system, system-ui, sans-serif; }
canvas { display: block; width: 100%; height: 100%; min-height: 320px; touch-action: none; }
p { position: fixed; left: 0; right: 0; top: 10px; margin: 0; text-align: center; color: #a39fb3; font-size: 0.85rem; }
button { font: inherit; border: 0; border-radius: 8px; padding: 4px 10px; background: #2f2b40; color: #f1eef7; }
--- script.js
const canvas = document.getElementById("world");
const ctx = canvas.getContext("2d");
const GRAVITY = 0.35, BOUNCE = 0.82, COLORS = ["#ff9a1a", "#ff5e62", "#5ee08a", "#3b9cff", "#8e6bff", "#ffd166"];
let width, height;
const balls = [];

function resize() {
  const ratio = window.devicePixelRatio || 1;
  width = canvas.clientWidth;
  height = canvas.clientHeight;
  canvas.width = width * ratio;
  canvas.height = height * ratio;
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
}

function addBall(x, y) {
  const r = 12 + Math.random() * 16;
  balls.push({ x, y, r, vx: (Math.random() - 0.5) * 8, vy: -Math.random() * 6, color: COLORS[balls.length % COLORS.length] });
  if (balls.length > 40) balls.shift();
}

function collide(a, b) {
  const dx = b.x - a.x, dy = b.y - a.y, distance = Math.hypot(dx, dy), overlap = a.r + b.r - distance;
  if (overlap <= 0 || distance === 0) return;
  const nx = dx / distance, ny = dy / distance;
  // Push them apart, then swap the part of their speed that points at each other.
  a.x -= nx * overlap / 2; a.y -= ny * overlap / 2;
  b.x += nx * overlap / 2; b.y += ny * overlap / 2;
  const relative = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny;
  if (relative > 0) return;
  a.vx += relative * nx; a.vy += relative * ny;
  b.vx -= relative * nx; b.vy -= relative * ny;
}

function frame() {
  ctx.clearRect(0, 0, width, height);
  for (const ball of balls) {
    ball.vy += GRAVITY;
    ball.x += ball.vx;
    ball.y += ball.vy;
    if (ball.y + ball.r > height) { ball.y = height - ball.r; ball.vy *= -BOUNCE; ball.vx *= 0.99; }
    if (ball.x - ball.r < 0) { ball.x = ball.r; ball.vx *= -BOUNCE; }
    if (ball.x + ball.r > width) { ball.x = width - ball.r; ball.vx *= -BOUNCE; }
  }
  for (let i = 0; i < balls.length; i++) for (let j = i + 1; j < balls.length; j++) collide(balls[i], balls[j]);
  for (const ball of balls) {
    ctx.fillStyle = ball.color;
    ctx.beginPath();
    ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
    ctx.fill();
  }
  requestAnimationFrame(frame);
}

canvas.addEventListener("pointerdown", (event) => addBall(event.clientX, event.clientY));
document.getElementById("clear").addEventListener("click", () => { balls.length = 0; });
window.addEventListener("resize", resize);
resize();
for (let i = 0; i < 5; i++) addBall(width * (0.2 + i * 0.15), 60 + i * 20);
frame();
