=== hello-page | Hello, Web | Starter | globe | Your first page: headings, text, a list, a link and a button that does something.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hello, Web</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <h1>Hello, Web 👋</h1>
    <p>This page is three files working together. Tap ▶ to preview it, then change something and watch it update.</p>
    <ul>
      <li><strong>index.html</strong> is the content</li>
      <li><strong>style.css</strong> is the look</li>
      <li><strong>script.js</strong> is the behaviour</li>
    </ul>
    <button id="hello">Tap me</button>
    <p id="message" class="muted">You haven't tapped yet.</p>
    <p><a href="https://developer.mozilla.org/en-US/docs/Learn">Learn more on MDN</a></p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
body {
  margin: 0;
  font-family: -apple-system, system-ui, sans-serif;
  background: #14121c;
  color: #f1eef7;
  line-height: 1.6;
}
main { max-width: 560px; margin: 0 auto; padding: 28px 20px; }
h1 { font-size: 2rem; margin: 0 0 8px; }
a { color: #ffb347; }
.muted { color: #a39fb3; }
button {
  font: inherit; font-weight: 600;
  padding: 12px 22px; border: 0; border-radius: 12px;
  background: #ff9a1a; color: #1a1300;
}
button:active { transform: scale(0.96); }
--- script.js
const button = document.getElementById("hello");
const message = document.getElementById("message");
let taps = 0;

button.addEventListener("click", () => {
  taps++;
  message.textContent = taps === 1 ? "You tapped once. 🎉" : `You tapped ${taps} times.`;
});

=== profile-card | Profile Card | Starter | person.crop.square.fill | A tidy card with an avatar, bio, stats and a follow button.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile Card</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <article class="card">
    <div class="avatar">AL</div>
    <h1>Ada Lovelace</h1>
    <p class="role">Mathematician · First programmer</p>
    <p class="bio">Writing programs for machines that don't exist yet. Fond of poetry and prime numbers.</p>
    <dl class="stats">
      <div><dt>Posts</dt><dd>128</dd></div>
      <div><dt>Followers</dt><dd id="followers">4,210</dd></div>
      <div><dt>Following</dt><dd>89</dd></div>
    </dl>
    <button id="follow">Follow</button>
  </article>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body {
  margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 20px;
  font-family: -apple-system, system-ui, sans-serif;
  background: linear-gradient(160deg, #2a1f4d, #14121c);
  color: #f1eef7;
}
.card {
  width: 100%; max-width: 340px; padding: 28px 24px; text-align: center;
  background: #211e2e; border-radius: 24px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
}
.avatar {
  width: 88px; height: 88px; margin: 0 auto 14px; border-radius: 50%;
  display: grid; place-items: center; font-size: 30px; font-weight: 700;
  background: linear-gradient(135deg, #ff9a1a, #ff5e62); color: #fff;
}
h1 { margin: 0; font-size: 1.4rem; }
.role { margin: 4px 0 14px; color: #ffb347; font-size: 0.9rem; }
.bio { margin: 0 0 20px; color: #b8b3c7; line-height: 1.5; }
.stats { display: flex; justify-content: space-around; margin: 0 0 22px; }
.stats dt { font-size: 0.75rem; color: #8f8aa3; }
.stats dd { margin: 2px 0 0; font-size: 1.15rem; font-weight: 700; }
button {
  width: 100%; padding: 13px; border: 0; border-radius: 14px;
  font: inherit; font-weight: 700; background: #ff9a1a; color: #1a1300; transition: 0.2s;
}
button.following { background: transparent; color: #f1eef7; box-shadow: inset 0 0 0 2px #4a4560; }
--- script.js
const button = document.getElementById("follow");
const followers = document.getElementById("followers");
let count = 4210;
let following = false;

button.addEventListener("click", () => {
  following = !following;
  count += following ? 1 : -1;
  followers.textContent = count.toLocaleString();
  button.textContent = following ? "Following ✓" : "Follow";
  button.classList.toggle("following", following);
});

=== link-in-bio | Link in Bio | Starter | link.circle.fill | A personal links page like the ones in social profiles. Edit the list in one place.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Links</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <div class="avatar">🥭</div>
    <h1>@mango</h1>
    <p class="tagline">Code, mods and other experiments</p>
    <nav id="links"></nav>
    <footer>Made with MangoIDE</footer>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body {
  margin: 0; min-height: 100vh; padding: 36px 20px;
  font-family: -apple-system, system-ui, sans-serif; text-align: center;
  background: radial-gradient(circle at top, #3b2a12, #14121c 60%); color: #f1eef7;
}
main { max-width: 420px; margin: 0 auto; }
.avatar {
  width: 84px; height: 84px; margin: 0 auto 12px; border-radius: 50%;
  display: grid; place-items: center; font-size: 40px; background: #2a2636;
}
h1 { margin: 0; font-size: 1.3rem; }
.tagline { margin: 4px 0 24px; color: #a39fb3; }
nav a {
  display: flex; align-items: center; gap: 12px; margin-bottom: 12px; padding: 15px 18px;
  border-radius: 16px; background: #211e2e; color: inherit; text-decoration: none; font-weight: 600;
  border: 1px solid #332f44; transition: transform 0.15s, border-color 0.15s;
}
nav a:active { transform: scale(0.97); border-color: #ff9a1a; }
nav a span:last-child { margin-left: auto; color: #6f6a85; }
footer { margin-top: 24px; font-size: 0.8rem; color: #6f6a85; }
--- script.js
// Add, remove or reorder your links here.
const LINKS = [
  { icon: "💻", title: "GitHub", url: "https://github.com" },
  { icon: "🎬", title: "YouTube", url: "https://youtube.com" },
  { icon: "💬", title: "Telegram", url: "https://telegram.org" },
  { icon: "📝", title: "Blog", url: "https://example.com/blog" },
  { icon: "✉️", title: "Email me", url: "mailto:hello@example.com" },
];

const nav = document.getElementById("links");
for (const link of LINKS) {
  const a = document.createElement("a");
  a.href = link.url;
  a.innerHTML = `<span>${link.icon}</span><span>${link.title}</span><span>›</span>`;
  nav.appendChild(a);
}

