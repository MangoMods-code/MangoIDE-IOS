* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; line-height: 1.5; }
.hero { padding: 56px 22px 44px; text-align: center; background: linear-gradient(170deg, #3a2470, #14121c); }
.badge { display: inline-block; padding: 4px 12px; border-radius: 99px; background: #ff9a1a; color: #1a1300; font-size: 0.75rem; font-weight: 700; }
h1 { margin: 14px auto 10px; max-width: 14ch; font-size: 2.1rem; line-height: 1.15; }
.hero p { margin: 0 auto 22px; max-width: 32ch; color: #c5c0d6; }
.button { display: inline-block; padding: 13px 26px; border-radius: 14px; background: #ff9a1a; color: #1a1300; font-weight: 700; text-decoration: none; }
.features, .pricing { display: grid; gap: 14px; padding: 26px 20px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); max-width: 760px; margin: 0 auto; }
article { padding: 18px; border-radius: 18px; background: #211e2e; }
h2 { margin: 0 0 6px; font-size: 1.05rem; }
article p { margin: 0; color: #a39fb3; font-size: 0.92rem; }
.pricing article { text-align: center; }
.pricing h3 { margin: 0; }
.price { font-size: 2rem; font-weight: 800; color: #f1eef7 !important; margin: 6px 0 !important; }
.price small { font-size: 0.9rem; font-weight: 500; color: #a39fb3; }
.featured { outline: 2px solid #ff9a1a; }
footer { padding: 26px 20px 40px; text-align: center; color: #6f6a85; font-size: 0.85rem; }

=== recipe-page | Recipe Page | Starter | fork.knife | Semantic HTML in practice: sections, lists, a table and a checklist you can tick.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mango Lassi</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <article>
    <header>
      <p class="kicker">Drinks · 5 minutes</p>
      <h1>Mango Lassi</h1>
      <p>A cold, creamy yogurt drink. Ripe mangoes do most of the work.</p>
    </header>
    <section>
      <h2>Ingredients</h2>
      <ul class="checklist">
        <li><label><input type="checkbox"> 2 ripe mangoes, chopped</label></li>
        <li><label><input type="checkbox"> 1 cup plain yogurt</label></li>
        <li><label><input type="checkbox"> ½ cup cold milk</label></li>
        <li><label><input type="checkbox"> 1 tbsp honey</label></li>
        <li><label><input type="checkbox"> A pinch of cardamom</label></li>
      </ul>
    </section>
    <section>
      <h2>Steps</h2>
      <ol>
        <li>Add everything to a blender.</li>
        <li>Blend until completely smooth.</li>
        <li>Taste, then add honey or milk if needed.</li>
        <li>Pour over ice and serve right away.</li>
      </ol>
    </section>
    <section>
      <h2>Per glass</h2>
      <table>
        <tr><th>Calories</th><td>210</td></tr>
        <tr><th>Protein</th><td>7 g</td></tr>
        <tr><th>Sugar</th><td>34 g</td></tr>
      </table>
    </section>
  </article>
</body>
</html>
--- style.css
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #fff8ec; color: #2b2116; line-height: 1.6; }
article { max-width: 560px; margin: 0 auto; padding: 28px 22px 48px; }
.kicker { margin: 0; color: #c9720a; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
h1 { margin: 4px 0 6px; font-size: 2.2rem; font-family: Georgia, serif; }
h2 { margin: 28px 0 10px; font-size: 1.15rem; border-bottom: 2px solid #ffd8a0; padding-bottom: 4px; }
.checklist { list-style: none; padding: 0; margin: 0; }
.checklist label { display: flex; gap: 10px; align-items: center; padding: 7px 0; }
.checklist input { width: 20px; height: 20px; accent-color: #f08c00; }
.checklist input:checked + * , .checklist label:has(input:checked) { color: #a8977f; text-decoration: line-through; }
ol { padding-left: 22px; margin: 0; }
ol li { padding: 4px 0; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 9px 4px; border-bottom: 1px solid #f0dfc4; text-align: left; }
td { text-align: right; font-weight: 600; }

=== flexbox-playground | Flexbox Playground | Layout & CSS | rectangle.split.3x1.fill | Tap the options and watch how flexbox arranges the boxes.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Flexbox Playground</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>Flexbox Playground</h1>
  <div id="stage"><div>1</div><div>2</div><div>3</div><div>4</div></div>
  <pre id="code"></pre>
  <div id="controls"></div>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; padding: 18px; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
h1 { margin: 0 0 12px; font-size: 1.3rem; }
#stage {
  display: flex; gap: 8px; height: 170px; padding: 8px;
  border-radius: 16px; background: #211e2e; border: 2px dashed #3d3852;
}
#stage div {
  min-width: 46px; min-height: 46px; padding: 8px; border-radius: 10px;
  display: grid; place-items: center; font-weight: 700; color: #1a1300;
  background: linear-gradient(135deg, #ffb347, #ff7a59); transition: all 0.3s;
}
#stage div:nth-child(2) { min-height: 70px; }
#stage div:nth-child(3) { min-height: 96px; }
pre { margin: 12px 0; padding: 12px; border-radius: 12px; background: #0e0c14; color: #9be9a8; font-size: 0.82rem; overflow-x: auto; }
.group { margin-bottom: 12px; }
.group p { margin: 0 0 6px; font-size: 0.8rem; color: #a39fb3; }
.group div { display: flex; flex-wrap: wrap; gap: 6px; }
button { font: inherit; font-size: 0.8rem; padding: 7px 11px; border-radius: 9px; border: 0; background: #2f2b40; color: #d9d5e6; }
button.on { background: #ff9a1a; color: #1a1300; font-weight: 700; }
--- script.js
const OPTIONS = {
  "flex-direction": ["row", "row-reverse", "column", "column-reverse"],
  "justify-content": ["flex-start", "center", "flex-end", "space-between", "space-around", "space-evenly"],
  "align-items": ["stretch", "flex-start", "center", "flex-end"],
  "flex-wrap": ["nowrap", "wrap"],
};
const current = { "flex-direction": "row", "justify-content": "flex-start", "align-items": "stretch", "flex-wrap": "nowrap" };
const stage = document.getElementById("stage");
const controls = document.getElementById("controls");

function render() {
  for (const [property, value] of Object.entries(current)) stage.style.setProperty(property, value);
  document.getElementById("code").textContent =
    "display: flex;\n" + Object.entries(current).map(([p, v]) => `${p}: ${v};`).join("\n");
  for (const b of controls.querySelectorAll("button")) b.classList.toggle("on", current[b.dataset.property] === b.textContent);
}

for (const [property, values] of Object.entries(OPTIONS)) {
  const group = document.createElement("div");
  group.className = "group";
  group.innerHTML = `<p>${property}</p><div></div>`;
  for (const value of values) {
    const b = document.createElement("button");
    b.textContent = value;
    b.dataset.property = property;
    b.addEventListener("click", () => { current[property] = value; render(); });
    group.lastChild.appendChild(b);
  }
  controls.appendChild(group);
}
render();

=== grid-dashboard | Grid Dashboard | Layout & CSS | square.grid.2x2.fill | A responsive dashboard built with CSS Grid: stat cards, a chart and a list.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>Dashboard</h1>
  <div class="grid">
    <section class="stat"><p>Visitors</p><strong>12,480</strong><span class="up">▲ 8%</span></section>
    <section class="stat"><p>Sales</p><strong>$3,910</strong><span class="up">▲ 12%</span></section>
    <section class="stat"><p>Refunds</p><strong>14</strong><span class="down">▼ 3%</span></section>
    <section class="stat"><p>Rating</p><strong>4.8</strong><span class="up">▲ 0.1</span></section>
    <section class="chart">
      <h2>This week</h2>
      <div class="bars" id="bars"></div>
    </section>
    <section class="list">
      <h2>Recent orders</h2>
      <ul>
        <li><span>Mango crate</span><b>$48</b></li>
        <li><span>Lime box</span><b>$19</b></li>
        <li><span>Blender</span><b>$129</b></li>
        <li><span>Gift card</span><b>$25</b></li>
      </ul>
    </section>
  </div>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; padding: 18px; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
h1 { margin: 0 0 14px; font-size: 1.4rem; }
h2 { margin: 0 0 12px; font-size: 0.95rem; color: #a39fb3; font-weight: 600; }
/* Two columns on a phone, four on anything wider. */
.grid { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
@media (min-width: 640px) { .grid { grid-template-columns: repeat(4, 1fr); } }
section { padding: 16px; border-radius: 16px; background: #211e2e; }
.stat p { margin: 0; font-size: 0.8rem; color: #a39fb3; }
.stat strong { display: block; margin: 4px 0; font-size: 1.5rem; }
.up { color: #5ee08a; font-size: 0.8rem; }
.down { color: #ff6b6b; font-size: 0.8rem; }
.chart, .list { grid-column: 1 / -1; }
@media (min-width: 640px) { .chart, .list { grid-column: span 2; } }
.bars { display: flex; align-items: flex-end; gap: 8px; height: 120px; }
.bars div { flex: 1; border-radius: 6px 6px 2px 2px; background: linear-gradient(#ffb347, #ff7a59); position: relative; transition: height 0.6s ease; }
.bars span { position: absolute; bottom: -20px; left: 0; right: 0; text-align: center; font-size: 0.7rem; color: #8f8aa3; }
.chart { padding-bottom: 34px; }
ul { list-style: none; margin: 0; padding: 0; }
li { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid #2f2b40; }
li:last-child { border: 0; }
--- script.js
const WEEK = { Mon: 42, Tue: 58, Wed: 35, Thu: 71, Fri: 64, Sat: 90, Sun: 77 };
const bars = document.getElementById("bars");
const highest = Math.max(...Object.values(WEEK));

for (const [day, value] of Object.entries(WEEK)) {
  const bar = document.createElement("div");
  bar.style.height = "0%";
  bar.innerHTML = `<span>${day}</span>`;
  bars.appendChild(bar);
  // Set the real height a moment later so the bars grow into place.
  requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.height = (value / highest) * 100 + "%"; }));
}

=== responsive-navbar | Responsive Menu | Layout & CSS | line.3.horizontal | A navigation bar that turns into a slide-down menu on small screens.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Responsive Menu</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <a class="logo" href="#">🥭 Mango</a>
    <button id="toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav id="menu">
      <a href="#home" class="active">Home</a>
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
  <main>
    <h1 id="title">Home</h1>
    <p>Tap the menu button. On a wide screen the links sit in the bar instead.</p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
header { position: sticky; top: 0; display: flex; flex-wrap: wrap; align-items: center; padding: 12px 18px; background: #211e2e; }
.logo { font-weight: 800; font-size: 1.1rem; color: inherit; text-decoration: none; margin-right: auto; }
#toggle { width: 42px; height: 42px; border: 0; border-radius: 10px; background: #2f2b40; display: grid; gap: 5px; place-content: center; }
#toggle span { width: 20px; height: 2px; border-radius: 2px; background: #f1eef7; transition: 0.25s; }
#toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
#toggle.open span:nth-child(2) { opacity: 0; }
#toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
nav { width: 100%; display: grid; max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
nav.open { max-height: 260px; }
nav a { padding: 13px 4px; color: #c5c0d6; text-decoration: none; border-top: 1px solid #2f2b40; }
nav a.active { color: #ff9a1a; font-weight: 700; }
main { padding: 26px 20px; max-width: 640px; margin: 0 auto; line-height: 1.6; }
/* Wide screens: hide the button, show the links in a row. */
@media (min-width: 640px) {
  #toggle { display: none; }
  nav { width: auto; display: flex; gap: 22px; max-height: none; }
  nav a { border: 0; padding: 6px 0; }
}
--- script.js
const toggle = document.getElementById("toggle");
const menu = document.getElementById("menu");

toggle.addEventListener("click", () => {
  const open = menu.classList.toggle("open");
  toggle.classList.toggle("open", open);
  toggle.setAttribute("aria-expanded", open);
});

menu.addEventListener("click", (event) => {
  const link = event.target.closest("a");
  if (!link) return;
  event.preventDefault();
  for (const a of menu.querySelectorAll("a")) a.classList.toggle("active", a === link);
  document.getElementById("title").textContent = link.textContent;
  menu.classList.remove("open");
  toggle.classList.remove("open");
});

=== theme-toggle | Dark & Light Theme | Layout & CSS | circle.lefthalf.filled | Switch a whole page between light and dark with CSS variables, and remember the choice.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Themes</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <button id="toggle" aria-label="Switch theme">🌙</button>
    <h1>One page, two looks</h1>
    <p>Every color on this page comes from a CSS variable. Switching theme just swaps the variables.</p>
    <div class="card">
      <h2>How it works</h2>
      <p><code>:root</code> holds the light colors and <code>[data-theme="dark"]</code> overrides them.</p>
      <button class="primary">A button</button>
    </div>
    <p class="muted" id="status"></p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
:root {
  --bg: #f6f4fb; --card: #ffffff; --text: #1d1a29; --muted: #6f6a85; --accent: #e8590c; --border: #e3dff0;
}
[data-theme="dark"] {
  --bg: #14121c; --card: #211e2e; --text: #f1eef7; --muted: #a39fb3; --accent: #ff9a1a; --border: #332f44;
}
* { box-sizing: border-box; }
body {
  margin: 0; font-family: -apple-system, system-ui, sans-serif; line-height: 1.6;
  background: var(--bg); color: var(--text); transition: background 0.3s, color 0.3s;
}
main { max-width: 560px; margin: 0 auto; padding: 24px 20px; }
h1 { margin: 8px 0; font-size: 1.7rem; }
h2 { margin: 0 0 6px; font-size: 1.05rem; }
.card { padding: 18px; border-radius: 18px; background: var(--card); border: 1px solid var(--border); transition: background 0.3s, border-color 0.3s; }
code { padding: 2px 6px; border-radius: 6px; background: var(--border); font-size: 0.85em; }
.muted { color: var(--muted); font-size: 0.85rem; }
#toggle { float: right; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--border); background: var(--card); font-size: 20px; }
.primary { margin-top: 6px; padding: 11px 20px; border: 0; border-radius: 12px; font: inherit; font-weight: 700; background: var(--accent); color: #fff; }
--- script.js
const toggle = document.getElementById("toggle");
const status = document.getElementById("status");

// localStorage can be unavailable in some previews, so every use is wrapped.
const saved = (() => { try { return localStorage.getItem("theme"); } catch (e) { return null; } })();
const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

function apply(theme, remember) {
  document.documentElement.dataset.theme = theme;
  toggle.textContent = theme === "dark" ? "☀️" : "🌙";
  status.textContent = `Theme: ${theme}` + (remember ? " (saved for next time)" : " (following your device)");
  if (remember) { try { localStorage.setItem("theme", theme); } catch (e) {} }
}

apply(saved || (systemDark ? "dark" : "light"), Boolean(saved));
toggle.addEventListener("click", () => apply(document.documentElement.dataset.theme === "dark" ? "light" : "dark", true));

=== css-animations | CSS Animations | Layout & CSS | sparkles | Spinners, pulses, bounces, shimmer and typing effects, all without JavaScript.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CSS Animations</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>CSS Animations</h1>
  <div class="grid">
    <figure><div class="spinner"></div><figcaption>Spinner</figcaption></figure>
    <figure><div class="pulse"></div><figcaption>Pulse</figcaption></figure>
    <figure><div class="bounce"><i></i><i></i><i></i></div><figcaption>Bounce</figcaption></figure>
    <figure><div class="shimmer"></div><figcaption>Loading shimmer</figcaption></figure>
    <figure><div class="typing">Hello, world</div><figcaption>Typing</figcaption></figure>
    <figure><div class="float">🥭</div><figcaption>Float</figcaption></figure>
    <figure><div class="flip"><span>Tap &amp; hold</span></div><figcaption>Transition</figcaption></figure>
    <figure><div class="gradient"></div><figcaption>Moving gradient</figcaption></figure>
  </div>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; padding: 18px; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
h1 { margin: 0 0 14px; font-size: 1.3rem; }
.grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
figure { margin: 0; height: 130px; border-radius: 16px; background: #211e2e; display: grid; place-items: center; grid-template-rows: 1fr auto; padding: 12px; }
figcaption { font-size: 0.75rem; color: #a39fb3; }

.spinner { width: 38px; height: 38px; border-radius: 50%; border: 4px solid #3d3852; border-top-color: #ff9a1a; animation: spin 0.9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.pulse { width: 22px; height: 22px; border-radius: 50%; background: #ff5e62; animation: pulse 1.6s ease-out infinite; }
@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(255, 94, 98, 0.7); } 100% { box-shadow: 0 0 0 26px rgba(255, 94, 98, 0); } }

.bounce { display: flex; gap: 6px; }
.bounce i { width: 12px; height: 12px; border-radius: 50%; background: #5ee08a; animation: bounce 0.9s ease-in-out infinite; }
.bounce i:nth-child(2) { animation-delay: 0.15s; }
.bounce i:nth-child(3) { animation-delay: 0.3s; }
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-16px); } }

.shimmer { width: 100%; height: 16px; border-radius: 8px; background: linear-gradient(90deg, #2f2b40 25%, #4a4560 50%, #2f2b40 75%); background-size: 200% 100%; animation: shimmer 1.4s linear infinite; }
@keyframes shimmer { to { background-position: -200% 0; } }

.typing { font-family: ui-monospace, Menlo, monospace; font-size: 0.85rem; white-space: nowrap; overflow: hidden; border-right: 2px solid #ff9a1a; width: 12ch; animation: typing 3s steps(12) infinite alternate, blink 0.7s step-end infinite; }
@keyframes typing { from { width: 0; } }
@keyframes blink { 50% { border-color: transparent; } }

.float { font-size: 38px; animation: float 3s ease-in-out infinite; }
@keyframes float { 50% { transform: translateY(-10px) rotate(8deg); } }

.flip { padding: 10px 14px; border-radius: 10px; background: #2f2b40; font-size: 0.8rem; transition: transform 0.4s, background 0.4s; }
.flip:active { transform: scale(1.15) rotate(-4deg); background: #ff9a1a; color: #1a1300; }

.gradient { width: 100%; height: 44px; border-radius: 12px; background: linear-gradient(90deg, #ff9a1a, #ff5e62, #8e6bff, #ff9a1a); background-size: 300% 100%; animation: slide 5s linear infinite; }
@keyframes slide { to { background-position: 300% 0; } }

=== ui-components | UI Components | Layout & CSS | rectangle.3.group.fill | Tabs, an accordion, a pop-up dialog and toast messages you can reuse anywhere.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>UI Components</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <h2>Tabs</h2>
    <div class="tabs" id="tabs">
      <button class="on" data-tab="one">Overview</button><button data-tab="two">Details</button><button data-tab="three">Reviews</button>
    </div>
    <div class="panel" id="panel">A short overview of the product.</div>

    <h2>Accordion</h2>
    <details open><summary>What is MangoIDE?</summary><p>A code editor for iPhone and iPad.</p></details>
    <details><summary>Does it work offline?</summary><p>Yes. Editing and JavaScript run on the device.</p></details>
    <details><summary>Can I use my own themes?</summary><p>Yes, through extensions.</p></details>

    <h2>Dialog &amp; toast</h2>
    <button class="primary" id="open">Open dialog</button>
    <button class="primary ghost" id="toast">Show toast</button>
  </main>
  <div class="backdrop" id="backdrop">
    <div class="dialog">
      <h3>Delete this file?</h3>
      <p>This can't be undone.</p>
      <div class="row"><button id="cancel">Cancel</button><button class="danger" id="confirm">Delete</button></div>
    </div>
  </div>
  <div id="toasts"></div>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 560px; margin: 0 auto; padding: 18px 18px 60px; }
h2 { margin: 22px 0 10px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; color: #a39fb3; }
button { font: inherit; border: 0; border-radius: 10px; padding: 10px 14px; background: #2f2b40; color: #f1eef7; }
.tabs { display: flex; gap: 4px; padding: 4px; border-radius: 12px; background: #211e2e; }
.tabs button { flex: 1; background: transparent; color: #a39fb3; transition: 0.2s; }
.tabs button.on { background: #ff9a1a; color: #1a1300; font-weight: 700; }
.panel { margin-top: 8px; padding: 16px; border-radius: 12px; background: #211e2e; min-height: 60px; }
details { margin-bottom: 8px; border-radius: 12px; background: #211e2e; padding: 0 16px; }
summary { padding: 14px 0; font-weight: 600; cursor: pointer; }
details p { margin: 0; padding: 0 0 14px; color: #b8b3c7; }
.primary { background: #ff9a1a; color: #1a1300; font-weight: 700; margin-right: 8px; }
.ghost { background: transparent; color: #ff9a1a; box-shadow: inset 0 0 0 2px #ff9a1a; }
.backdrop { position: fixed; inset: 0; display: grid; place-items: center; padding: 24px; background: rgba(0, 0, 0, 0.55); opacity: 0; pointer-events: none; transition: opacity 0.2s; }
.backdrop.open { opacity: 1; pointer-events: auto; }
.dialog { width: 100%; max-width: 320px; padding: 22px; border-radius: 20px; background: #2a2636; transform: scale(0.92); transition: transform 0.2s; }
.backdrop.open .dialog { transform: scale(1); }
.dialog h3 { margin: 0 0 4px; }
.dialog p { margin: 0 0 18px; color: #b8b3c7; }
.row { display: flex; gap: 10px; }
.row button { flex: 1; }
.danger { background: #ff5e62; font-weight: 700; }
#toasts { position: fixed; left: 0; right: 0; bottom: 18px; display: grid; justify-items: center; gap: 8px; pointer-events: none; }
.toast { padding: 10px 16px; border-radius: 99px; background: #f1eef7; color: #14121c; font-weight: 600; font-size: 0.9rem; animation: rise 0.25s ease-out; transition: opacity 0.3s; }
@keyframes rise { from { transform: translateY(16px); opacity: 0; } }
--- script.js
// Tabs
const PANELS = { one: "A short overview of the product.", two: "Size, weight, materials and care.", three: "★★★★★ “Does exactly what it says.”" };
document.getElementById("tabs").addEventListener("click", (event) => {
  const button = event.target.closest("button");
  if (!button) return;
  for (const b of document.querySelectorAll("#tabs button")) b.classList.toggle("on", b === button);
  document.getElementById("panel").textContent = PANELS[button.dataset.tab];
});

// Toasts
function toast(message) {
  const el = document.createElement("div");
  el.className = "toast";
  el.textContent = message;
  document.getElementById("toasts").appendChild(el);
  setTimeout(() => { el.style.opacity = 0; }, 1800);
  setTimeout(() => el.remove(), 2200);
}
document.getElementById("toast").addEventListener("click", () => toast("Saved ✓"));

// Dialog
const backdrop = document.getElementById("backdrop");
const close = () => backdrop.classList.remove("open");
document.getElementById("open").addEventListener("click", () => backdrop.classList.add("open"));
document.getElementById("cancel").addEventListener("click", close);
document.getElementById("confirm").addEventListener("click", () => { close(); toast("Deleted"); });
backdrop.addEventListener("click", (event) => { if (event.target === backdrop) close(); });

=== counter | Counter | Apps | plusminus.circle.fill | The classic first app: a number, three buttons and a little animation.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Counter</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <p id="count">0</p>
    <div class="row">
      <button id="minus" aria-label="Decrease">−</button>
      <button id="reset">Reset</button>
      <button id="plus" aria-label="Increase">+</button>
    </div>
    <p class="hint">Hold + or − to count fast.</p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { text-align: center; }
#count { margin: 0 0 18px; font-size: 6rem; font-weight: 800; font-variant-numeric: tabular-nums; transition: color 0.2s; }
#count.bump { animation: bump 0.18s ease-out; }
#count.negative { color: #ff6b6b; }
#count.positive { color: #5ee08a; }
@keyframes bump { 50% { transform: scale(1.12); } }
.row { display: flex; gap: 12px; justify-content: center; }
button { min-width: 72px; height: 64px; border: 0; border-radius: 18px; font-size: 1.6rem; font-weight: 700; background: #2f2b40; color: #f1eef7; touch-action: manipulation; }
#plus { background: #ff9a1a; color: #1a1300; }
#reset { font-size: 1rem; }
button:active { transform: scale(0.94); }
.hint { margin-top: 18px; color: #6f6a85; font-size: 0.85rem; }
--- script.js
const display = document.getElementById("count");
let count = 0;

function update(by) {
  count = by === 0 ? 0 : count + by;
  display.textContent = count;
  display.classList.toggle("negative", count < 0);
  display.classList.toggle("positive", count > 0);
  display.classList.remove("bump");
  void display.offsetWidth;            // restart the animation
  display.classList.add("bump");
}

// Tap once, or hold to repeat.
function holdable(button, by) {
  let timer;
  const stop = () => clearInterval(timer);
  button.addEventListener("pointerdown", () => {
    update(by);
    timer = setInterval(() => update(by), 110);
  });
  for (const type of ["pointerup", "pointerleave", "pointercancel"]) button.addEventListener(type, stop);
}

holdable(document.getElementById("plus"), 1);
holdable(document.getElementById("minus"), -1);
document.getElementById("reset").addEventListener("click", () => update(0));

=== todo-app | To-Do App | Apps | checklist | Add tasks, tick them off, filter them. Saved between visits.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>To-Do</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <h1>To-Do <small id="left"></small></h1>
    <form id="form">
      <input id="input" placeholder="What needs doing?" autocomplete="off">
      <button>Add</button>
    </form>
    <div class="filters" id="filters">
      <button class="on" data-filter="all">All</button><button data-filter="active">Active</button><button data-filter="done">Done</button>
    </div>
    <ul id="list"></ul>
    <p class="empty" id="empty">Nothing here. Enjoy your day ☀️</p>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 520px; margin: 0 auto; padding: 22px 18px; }
h1 { margin: 0 0 14px; font-size: 1.6rem; }
h1 small { font-size: 0.85rem; font-weight: 500; color: #a39fb3; margin-left: 6px; }
form { display: flex; gap: 8px; }
input { flex: 1; min-width: 0; padding: 13px 14px; border-radius: 12px; border: 1px solid #3d3852; background: #211e2e; color: inherit; font: inherit; }
input:focus { outline: 2px solid #ff9a1a; border-color: transparent; }
button { font: inherit; border: 0; border-radius: 12px; padding: 0 18px; background: #ff9a1a; color: #1a1300; font-weight: 700; }
.filters { display: flex; gap: 6px; margin: 14px 0; }
.filters button { padding: 7px 14px; background: #211e2e; color: #a39fb3; font-weight: 500; }
.filters button.on { background: #f1eef7; color: #14121c; }
ul { list-style: none; margin: 0; padding: 0; }
li { display: flex; align-items: center; gap: 12px; padding: 13px 14px; margin-bottom: 8px; border-radius: 14px; background: #211e2e; animation: appear 0.2s ease-out; }
@keyframes appear { from { opacity: 0; transform: translateY(-6px); } }
li input { flex: none; width: 22px; height: 22px; padding: 0; accent-color: #ff9a1a; }
li span { flex: 1; overflow-wrap: anywhere; }
li.done span { color: #6f6a85; text-decoration: line-through; }
li button { padding: 6px 10px; background: transparent; color: #6f6a85; font-size: 1.1rem; }
.empty { text-align: center; color: #6f6a85; padding: 24px 0; }
--- script.js
const store = {
  load() { try { return JSON.parse(localStorage.getItem("todos")) || []; } catch (e) { return []; } },
  save(todos) { try { localStorage.setItem("todos", JSON.stringify(todos)); } catch (e) {} },
};

let todos = store.load();
if (!todos.length) todos = [{ id: 1, text: "Try adding a task", done: false }, { id: 2, text: "Tick this one off", done: true }];
let filter = "all";

const list = document.getElementById("list");

function render() {
  const shown = todos.filter((t) => filter === "all" || (filter === "done") === t.done);
  list.innerHTML = "";
  for (const todo of shown) {
    const li = document.createElement("li");
    li.className = todo.done ? "done" : "";
    li.dataset.id = todo.id;
    const text = document.createElement("span");
    text.textContent = todo.text;                 // textContent keeps typed HTML harmless
    li.innerHTML = `<input type="checkbox" ${todo.done ? "checked" : ""}>`;
    li.append(text);
    li.insertAdjacentHTML("beforeend", `<button aria-label="Delete">✕</button>`);
    list.appendChild(li);
  }
  document.getElementById("empty").hidden = shown.length > 0;
  const left = todos.filter((t) => !t.done).length;
  document.getElementById("left").textContent = `${left} left`;
  store.save(todos);
}

document.getElementById("form").addEventListener("submit", (event) => {
  event.preventDefault();
  const input = document.getElementById("input");
  const text = input.value.trim();
  if (!text) return;
  todos.unshift({ id: Date.now(), text, done: false });
  input.value = "";
  render();
});

list.addEventListener("click", (event) => {
  const li = event.target.closest("li");
  if (!li) return;
  const id = Number(li.dataset.id);
  if (event.target.matches("button")) todos = todos.filter((t) => t.id !== id);
  else if (event.target.matches("input")) todos.find((t) => t.id === id).done = event.target.checked;
  else return;
  render();
});

document.getElementById("filters").addEventListener("click", (event) => {
  if (!event.target.dataset.filter) return;
  filter = event.target.dataset.filter;
  for (const b of document.querySelectorAll("#filters button")) b.classList.toggle("on", b === event.target);
  render();
});

render();

=== calculator | Calculator | Apps | plus.forwardslash.minus | A working pocket calculator with a clean grid of buttons.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Calculator</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="calc">
    <div class="screen"><small id="history"></small><output id="display">0</output></div>
    <div class="keys" id="keys"></div>
  </div>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
.calc { width: 100%; max-width: 340px; padding: 16px; border-radius: 28px; background: #1c1926; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5); }
.screen { padding: 8px 8px 14px; text-align: right; min-height: 96px; display: grid; align-content: end; }
.screen small { color: #8f8aa3; min-height: 1.2em; }
output { font-size: 3rem; font-weight: 300; font-variant-numeric: tabular-nums; overflow: hidden; white-space: nowrap; }
.keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
button { aspect-ratio: 1; border: 0; border-radius: 50%; font-size: 1.35rem; background: #2f2b40; color: #f1eef7; touch-action: manipulation; transition: filter 0.1s; }
button:active { filter: brightness(1.5); }
button.fn { background: #a39fb3; color: #14121c; }
button.op { background: #ff9a1a; color: #1a1300; font-size: 1.6rem; }
button.wide { grid-column: span 2; aspect-ratio: auto; border-radius: 99px; text-align: left; padding-left: 26px; }
--- script.js
const LAYOUT = ["AC", "±", "%", "÷", "7", "8", "9", "×", "4", "5", "6", "−", "1", "2", "3", "+", "0", ".", "="];
const OPS = { "÷": (a, b) => a / b, "×": (a, b) => a * b, "−": (a, b) => a - b, "+": (a, b) => a + b };

let current = "0", stored = null, op = null, fresh = true;
const display = document.getElementById("display");
const history = document.getElementById("history");
const keys = document.getElementById("keys");

for (const key of LAYOUT) {
  const b = document.createElement("button");
  b.textContent = key;
  if (key in OPS || key === "=") b.className = "op";
  else if (["AC", "±", "%"].includes(key)) b.className = "fn";
  if (key === "0") b.classList.add("wide");
  keys.appendChild(b);
}

const format = (n) => (Number.isFinite(n) ? String(+n.toPrecision(10)) : "Error");

function press(key) {
  if (/\d/.test(key)) {
    current = fresh || current === "0" ? key : current + key;
    fresh = false;
  } else if (key === ".") {
    if (fresh) { current = "0."; fresh = false; } else if (!current.includes(".")) current += ".";
  } else if (key === "AC") {
    current = "0"; stored = null; op = null; fresh = true; history.textContent = "";
  } else if (key === "±") {
    current = format(-parseFloat(current));
  } else if (key === "%") {
    current = format(parseFloat(current) / 100);
  } else {
    const value = parseFloat(current);
    if (op && !fresh) {
      stored = OPS[op](stored, value);
      current = format(stored);
    } else if (stored === null || key !== "=") stored = value;
    op = key === "=" ? null : key;
    history.textContent = op ? `${format(stored)} ${op}` : "";
    if (key === "=") stored = null;
    fresh = true;
  }
  display.textContent = current.length > 11 ? format(parseFloat(current)) : current;
}

keys.addEventListener("click", (event) => { if (event.target.matches("button")) press(event.target.textContent); });

=== stopwatch | Stopwatch | Apps | stopwatch.fill | Start, stop and record laps, accurate to a hundredth of a second.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Stopwatch</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <p id="time">00:00.00</p>
    <div class="row">
      <button id="lap" disabled>Lap</button>
      <button id="toggle" class="go">Start</button>
    </div>
    <ol id="laps" reversed></ol>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 420px; margin: 0 auto; padding: 36px 20px; text-align: center; }
#time { margin: 0 0 26px; font-size: 3.6rem; font-weight: 200; font-variant-numeric: tabular-nums; }
.row { display: flex; justify-content: space-between; }
button { width: 88px; height: 88px; border-radius: 50%; border: 0; font: inherit; font-weight: 600; background: #2f2b40; color: #f1eef7; touch-action: manipulation; }
button:disabled { opacity: 0.4; }
button.go { background: #1f4d33; color: #5ee08a; }
button.stop { background: #5a1f24; color: #ff6b6b; }
ol { list-style: none; margin: 26px 0 0; padding: 0; text-align: left; }
li { display: flex; justify-content: space-between; padding: 12px 4px; border-top: 1px solid #2f2b40; font-variant-numeric: tabular-nums; }
li.best { color: #5ee08a; }
li.worst { color: #ff6b6b; }
--- script.js
const timeEl = document.getElementById("time");
const toggle = document.getElementById("toggle");
const lapButton = document.getElementById("lap");
const lapsEl = document.getElementById("laps");

let running = false, startedAt = 0, elapsed = 0, lastLap = 0, frame;
const laps = [];

function format(ms) {
  const minutes = Math.floor(ms / 60000), seconds = Math.floor(ms / 1000) % 60, hundredths = Math.floor(ms / 10) % 100;
  return [minutes, seconds].map((n) => String(n).padStart(2, "0")).join(":") + "." + String(hundredths).padStart(2, "0");
}

const now = () => elapsed + (running ? performance.now() - startedAt : 0);

function tick() {
  timeEl.textContent = format(now());
  if (running) frame = requestAnimationFrame(tick);
}

function renderLaps() {
  const best = Math.min(...laps), worst = Math.max(...laps);
  lapsEl.innerHTML = "";
  laps.forEach((lap, i) => {
    const li = document.createElement("li");
    li.innerHTML = `<span>Lap ${i + 1}</span><span>${format(lap)}</span>`;
    if (laps.length > 1) li.className = lap === best ? "best" : lap === worst ? "worst" : "";
    lapsEl.prepend(li);
  });
}

toggle.addEventListener("click", () => {
  if (running) { elapsed = now(); running = false; cancelAnimationFrame(frame); }
  else { startedAt = performance.now(); running = true; tick(); }
  toggle.textContent = running ? "Stop" : "Start";
  toggle.className = running ? "stop" : "go";
  lapButton.disabled = !running && elapsed === 0;
  lapButton.textContent = running || elapsed === 0 ? "Lap" : "Reset";
});

lapButton.addEventListener("click", () => {
  if (running) { laps.push(now() - lastLap); lastLap = now(); }
  else { elapsed = 0; lastLap = 0; laps.length = 0; lapButton.disabled = true; lapButton.textContent = "Lap"; tick(); }
  renderLaps();
});

=== tip-calculator | Tip Calculator | Apps | dollarsign.circle.fill | Sliders for the tip and the number of people, with the split updating live.
@entry index.html
--- index.html
<!doctype html>
