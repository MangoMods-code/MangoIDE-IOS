</head>
<body>
  <main>
    <h1>Tip Calculator</h1>
    <label>Bill
      <div class="money"><span>$</span><input id="bill" type="number" inputmode="decimal" value="48.50" min="0" step="0.01"></div>
    </label>
    <label>Tip <b id="tipLabel"></b>
      <input id="tip" type="range" min="0" max="30" value="18">
    </label>
    <div class="quick" id="quick"><button>10%</button><button>15%</button><button>18%</button><button>20%</button><button>25%</button></div>
    <label>People <b id="peopleLabel"></b>
      <input id="people" type="range" min="1" max="12" value="2">
    </label>
    <section class="result">
      <div><span>Tip</span><b id="tipAmount"></b></div>
      <div><span>Total</span><b id="total"></b></div>
      <div class="big"><span>Each pays</span><b id="each"></b></div>
    </section>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 420px; margin: 0 auto; padding: 22px 20px; }
h1 { margin: 0 0 18px; font-size: 1.5rem; }
label { display: block; margin-bottom: 16px; font-size: 0.9rem; color: #a39fb3; }
label b { float: right; color: #f1eef7; }
.money { display: flex; align-items: center; margin-top: 6px; padding: 0 14px; border-radius: 14px; background: #211e2e; }
.money span { font-size: 1.4rem; color: #6f6a85; }
input[type="number"] { flex: 1; min-width: 0; padding: 14px 8px; border: 0; background: transparent; color: #f1eef7; font-size: 1.6rem; font-weight: 700; outline: none; }
input[type="range"] { width: 100%; margin-top: 10px; accent-color: #ff9a1a; }
.quick { display: flex; gap: 6px; margin: -6px 0 18px; }
.quick button { flex: 1; padding: 8px 0; border: 0; border-radius: 10px; font: inherit; font-size: 0.85rem; background: #211e2e; color: #c5c0d6; }
.quick button.on { background: #ff9a1a; color: #1a1300; font-weight: 700; }
.result { padding: 16px 18px; border-radius: 18px; background: linear-gradient(135deg, #2c2150, #211e2e); }
.result div { display: flex; justify-content: space-between; padding: 6px 0; color: #c5c0d6; }
.result .big { margin-top: 6px; padding-top: 12px; border-top: 1px solid #3d3852; color: #f1eef7; font-size: 1.5rem; font-weight: 800; }
--- script.js
const $ = (id) => document.getElementById(id);
const money = (n) => "$" + n.toFixed(2);

function update() {
  const bill = Math.max(0, parseFloat($("bill").value) || 0);
  const percent = Number($("tip").value), people = Number($("people").value);
  const tip = bill * percent / 100, total = bill + tip;
  $("tipLabel").textContent = percent + "%";
  $("peopleLabel").textContent = people;
  $("tipAmount").textContent = money(tip);
  $("total").textContent = money(total);
  $("each").textContent = money(total / people);
  for (const b of document.querySelectorAll("#quick button")) b.classList.toggle("on", parseInt(b.textContent, 10) === percent);
}

for (const id of ["bill", "tip", "people"]) $(id).addEventListener("input", update);
$("quick").addEventListener("click", (event) => {
  if (!event.target.matches("button")) return;
  $("tip").value = parseInt(event.target.textContent, 10);
  update();
});
update();

=== quiz-app | Quiz App | Apps | lightbulb.fill | Multiple-choice questions with instant feedback, a progress bar and a final score.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quiz</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <div class="progress"><div id="bar"></div></div>
    <p class="step" id="step"></p>
    <h1 id="question"></h1>
    <div id="answers"></div>
    <button id="next" hidden>Next</button>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 480px; margin: 0 auto; padding: 22px 20px; }
.progress { height: 6px; border-radius: 3px; background: #2f2b40; overflow: hidden; }
#bar { height: 100%; width: 0; background: #ff9a1a; transition: width 0.4s ease; }
.step { margin: 16px 0 4px; color: #a39fb3; font-size: 0.85rem; }
h1 { margin: 0 0 18px; font-size: 1.35rem; line-height: 1.3; }
#answers button { display: block; width: 100%; margin-bottom: 10px; padding: 15px 16px; text-align: left; border-radius: 14px; border: 2px solid #332f44; background: #211e2e; color: inherit; font: inherit; transition: 0.15s; }
#answers button.right { border-color: #5ee08a; background: #173324; }
#answers button.wrong { border-color: #ff6b6b; background: #3a1a1e; }
#answers button:disabled { opacity: 0.85; }
#next { width: 100%; margin-top: 6px; padding: 15px; border: 0; border-radius: 14px; font: inherit; font-weight: 700; background: #ff9a1a; color: #1a1300; }
.score { font-size: 4rem; font-weight: 800; text-align: center; margin: 20px 0 6px; }
.center { text-align: center; color: #a39fb3; }
--- script.js
// Add your own: the question, the choices, and the position of the right one (starting at 0).
const QUESTIONS = [
  { q: "Which tag makes the biggest heading?", choices: ["<head>", "<h1>", "<h6>", "<title>"], answer: 1 },
  { q: "Which CSS property changes text color?", choices: ["font-color", "text-color", "color", "foreground"], answer: 2 },
  { q: "How do you write a comment in JavaScript?", choices: ["<!-- like this -->", "# like this", "// like this", "** like this **"], answer: 2 },
  { q: "What does CSS stand for?", choices: ["Cascading Style Sheets", "Creative Style System", "Computer Style Sheets", "Colorful Style Syntax"], answer: 0 },
  { q: "Which of these is NOT a JavaScript keyword?", choices: ["let", "const", "var", "define"], answer: 3 },
];

const $ = (id) => document.getElementById(id);
let index = 0, score = 0;

function show() {
  const item = QUESTIONS[index];
  $("bar").style.width = (index / QUESTIONS.length) * 100 + "%";
  $("step").textContent = `Question ${index + 1} of ${QUESTIONS.length}`;
  $("question").textContent = item.q;
  $("answers").innerHTML = "";
  $("next").hidden = true;
  item.choices.forEach((choice, i) => {
    const b = document.createElement("button");
    b.textContent = choice;
    b.addEventListener("click", () => pick(i));
    $("answers").appendChild(b);
  });
}

function pick(i) {
  const item = QUESTIONS[index], buttons = $("answers").children;
  for (const b of buttons) b.disabled = true;
  buttons[item.answer].classList.add("right");
  if (i === item.answer) score++; else buttons[i].classList.add("wrong");
  $("next").hidden = false;
  $("next").textContent = index === QUESTIONS.length - 1 ? "See my score" : "Next";
}

$("next").addEventListener("click", () => {
  index++;
  if (index < QUESTIONS.length) return show();
  if (index > QUESTIONS.length) { index = 0; score = 0; return show(); }
  $("bar").style.width = "100%";
  $("step").textContent = "";
  $("question").textContent = "";
  const percent = Math.round((score / QUESTIONS.length) * 100);
  $("answers").innerHTML = `<p class="score">${score}/${QUESTIONS.length}</p><p class="center">${percent >= 80 ? "Excellent! 🎉" : percent >= 50 ? "Not bad. Try again?" : "Keep practising 💪"}</p>`;
  $("next").textContent = "Play again";
});

show();

=== palette-generator | Color Palette Generator | Apps | paintpalette.fill | Make matching color schemes at random, lock the ones you like and copy their codes.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Palette Generator</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div id="palette"></div>
  <footer>
    <button id="generate">Generate</button>
    <span id="hint">Tap a color to lock it. Tap its code to copy.</span>
  </footer>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
html, body { height: 100%; }
body { margin: 0; display: flex; flex-direction: column; font-family: -apple-system, system-ui, sans-serif; background: #14121c; }
#palette { flex: 1; display: flex; flex-direction: column; min-height: 320px; }
.swatch { flex: 1; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; transition: background 0.35s ease, flex 0.25s; }
.swatch.locked { flex: 1.25; }
.swatch code { padding: 6px 10px; border-radius: 8px; background: rgba(0, 0, 0, 0.18); font-family: ui-monospace, Menlo, monospace; font-size: 1rem; font-weight: 600; }
.swatch span { font-size: 1.2rem; opacity: 0.85; }
footer { display: flex; align-items: center; gap: 14px; padding: 14px 18px; color: #a39fb3; font-size: 0.8rem; }
button { padding: 12px 22px; border: 0; border-radius: 12px; font: inherit; font-size: 1rem; font-weight: 700; background: #f1eef7; color: #14121c; }
--- script.js
const SIZE = 5;
const palette = document.getElementById("palette");
const hint = document.getElementById("hint");
const colors = Array.from({ length: SIZE }, () => ({ h: 0, s: 0, l: 0, locked: false }));

function hslToHex(h, s, l) {
  s /= 100; l /= 100;
  const a = s * Math.min(l, 1 - l);
  const channel = (n) => {
    const k = (n + h / 30) % 12;
    return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, "0");
  };
  return "#" + channel(0) + channel(8) + channel(4);
}

function generate() {
  // Hues spread around the color wheel from a random start look good together.
  const base = Math.random() * 360, spread = 20 + Math.random() * 50;
  colors.forEach((c, i) => {
    if (c.locked) return;
    c.h = (base + (i - 2) * spread + 360) % 360;
    c.s = 55 + Math.random() * 30;
    c.l = 30 + i * 11 + Math.random() * 6;
  });
  render();
}

function render() {
  palette.innerHTML = "";
  colors.forEach((c) => {
    const hex = hslToHex(c.h, c.s, c.l);
    const el = document.createElement("div");
    el.className = "swatch" + (c.locked ? " locked" : "");
    el.style.background = hex;
    el.style.color = c.l > 58 ? "#14121c" : "#ffffff";
    el.innerHTML = `<code>${hex.toUpperCase()}</code><span>${c.locked ? "🔒" : "🔓"}</span>`;
    el.addEventListener("click", (event) => {
      if (event.target.tagName === "CODE") {
        if (navigator.clipboard) navigator.clipboard.writeText(hex).catch(() => {});
        hint.textContent = `Copied ${hex.toUpperCase()}`;
      } else {
        c.locked = !c.locked;
        render();
      }
    });
    palette.appendChild(el);
  });
}

document.getElementById("generate").addEventListener("click", generate);
generate();

=== password-generator | Password Generator | Apps | key.fill | Pick a length and character types, get a strong password and a strength meter.
@entry index.html
--- index.html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Password Generator</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main>
    <h1>Password Generator</h1>
    <div class="output"><code id="password"></code><button id="copy" aria-label="Copy">Copy</button></div>
    <div class="meter"><div id="meter"></div></div>
    <p class="strength" id="strength"></p>
    <label>Length <b id="lengthLabel"></b><input id="length" type="range" min="6" max="40" value="16"></label>
    <label class="check"><input type="checkbox" id="upper" checked> Uppercase letters</label>
    <label class="check"><input type="checkbox" id="digits" checked> Numbers</label>
    <label class="check"><input type="checkbox" id="symbols" checked> Symbols</label>
    <button id="generate" class="primary">Generate another</button>
  </main>
  <script src="script.js"></script>
</body>
</html>
--- style.css
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #14121c; color: #f1eef7; }
main { max-width: 440px; margin: 0 auto; padding: 22px 20px; }
h1 { margin: 0 0 16px; font-size: 1.5rem; }
.output { display: flex; gap: 10px; align-items: center; padding: 14px; border-radius: 14px; background: #211e2e; }
code { flex: 1; font-family: ui-monospace, Menlo, monospace; font-size: 1.05rem; overflow-wrap: anywhere; }
button { font: inherit; border: 0; border-radius: 10px; padding: 9px 14px; background: #2f2b40; color: #f1eef7; }
.meter { height: 6px; margin-top: 12px; border-radius: 3px; background: #2f2b40; overflow: hidden; }
#meter { height: 100%; width: 0; transition: width 0.3s, background 0.3s; }
.strength { margin: 6px 0 18px; font-size: 0.85rem; color: #a39fb3; }
label { display: block; margin-bottom: 14px; color: #c5c0d6; }
label b { float: right; color: #f1eef7; }
input[type="range"] { display: block; width: 100%; margin-top: 8px; accent-color: #ff9a1a; }
.check { display: flex; align-items: center; gap: 10px; }
.check input { width: 22px; height: 22px; accent-color: #ff9a1a; }
.primary { width: 100%; margin-top: 6px; padding: 14px; font-weight: 700; background: #ff9a1a; color: #1a1300; border-radius: 14px; }
--- script.js
const $ = (id) => document.getElementById(id);
const SETS = { lower: "abcdefghijklmnopqrstuvwxyz", upper: "ABCDEFGHIJKLMNOPQRSTUVWXYZ", digits: "0123456789", symbols: "!@#$%^&*-_=+?" };

// crypto.getRandomValues gives random numbers that are safe to use for passwords.
function randomIndex(max) {
  const limit = Math.floor(0x100000000 / max) * max;
  const buffer = new Uint32Array(1);
  do { crypto.getRandomValues(buffer); } while (buffer[0] >= limit);
  return buffer[0] % max;
}

function generate() {
  const length = Number($("length").value);
  const sets = [SETS.lower].concat(["upper", "digits", "symbols"].filter((k) => $(k).checked).map((k) => SETS[k]));
  const all = sets.join("");
  const chars = sets.map((set) => set[randomIndex(set.length)]);          // one of each chosen kind
  while (chars.length < length) chars.push(all[randomIndex(all.length)]);
  for (let i = chars.length - 1; i > 0; i--) {                            // shuffle
    const j = randomIndex(i + 1);
    [chars[i], chars[j]] = [chars[j], chars[i]];
  }
  const password = chars.slice(0, length).join("");
  const bits = Math.round(length * Math.log2(all.length));
  $("password").textContent = password;
  $("lengthLabel").textContent = length;
  $("meter").style.width = Math.min(100, bits) + "%";
  $("meter").style.background = bits < 50 ? "#ff6b6b" : bits < 80 ? "#ffb347" : "#5ee08a";
  $("strength").textContent = `${bits} bits · ${bits < 50 ? "weak" : bits < 80 ? "good" : "strong"}`;
  $("copy").textContent = "Copy";
}

for (const id of ["length", "upper", "digits", "symbols"]) $(id).addEventListener("input", generate);
$("generate").addEventListener("click", generate);
$("copy").addEventListener("click", () => {
  if (navigator.clipboard) navigator.clipboard.writeText($("password").textContent).catch(() => {});
  $("copy").textContent = "Copied ✓";
});
generate();

