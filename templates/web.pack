form { max-width: 420px; margin: 0 auto; padding: 24px 20px; }
h1 { margin: 0 0 18px; font-size: 1.5rem; }
label { display: block; margin-bottom: 14px; font-size: 0.85rem; color: #a39fb3; }
input:not([type="checkbox"]) { display: block; width: 100%; margin-top: 6px; padding: 13px 14px; border-radius: 12px; border: 2px solid #332f44; background: #211e2e; color: #f1eef7; font: inherit; font-size: 1rem; outline: none; transition: border-color 0.15s; }
