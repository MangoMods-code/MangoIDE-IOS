=== csv-report | CSV Sales Report | Data | tablecells.fill | Parse CSV text (quotes included) and total it by product and month.
--- main.js
// A CSV parser that copes with quoted fields, then a small sales report.
const CSV = `month,product,units,price
Jan,Mango,120,1.50
Jan,Banana,200,0.40
Jan,"Papaya, large",30,3.20
Feb,Mango,150,1.50
Feb,Banana,180,0.45
Feb,"Papaya, large",45,3.20
Mar,Mango,210,1.60
Mar,Banana,160,0.45`;

function parseCSV(text) {
  const rows = text.trim().split("\n").map((line) => {
    const cells = [];
    let cell = "", quoted = false;
    for (const ch of line) {
      if (ch === '"') quoted = !quoted;
      else if (ch === "," && !quoted) { cells.push(cell); cell = ""; }
      else cell += ch;
    }
    cells.push(cell);
    return cells;
  });
  const [header, ...body] = rows;
  return body.map((cells) => Object.fromEntries(header.map((h, i) => [h, cells[i]])));
}

const sales = parseCSV(CSV).map((r) => ({ ...r, revenue: r.units * r.price }));
const totalBy = (key) => sales.reduce((acc, r) => ({ ...acc, [r[key]]: (acc[r[key]] || 0) + r.revenue }), {});
const total = sales.reduce((s, r) => s + r.revenue, 0);

console.log(`${sales.length} sales, $${total.toFixed(2)} total\n\nBy product:`);
for (const [product, revenue] of Object.entries(totalBy("product")).sort((a, b) => b[1] - a[1])) {
  console.log(`  ${product.padEnd(14)} $${revenue.toFixed(2).padStart(8)}  ${(revenue / total * 100).toFixed(1)}%`);
}
console.log("\nBy month:");
const months = totalBy("month"), top = Math.max(...Object.values(months));
for (const [month, revenue] of Object.entries(months)) console.log(`  ${month} ${"█".repeat(Math.round(24 * revenue / top))} $${revenue.toFixed(0)}`);

=== json-explorer | JSON Explorer | Data | curlybraces.square.fill | Walk through nested data as a tree and pull values out by path.
--- main.js
// Print any object as a tree, and read deep values safely with a path like "users.0.name".
const data = {
  app: "MangoIDE",
  version: 1,
  users: [
    { name: "Ada", active: true, tags: ["admin", "dev"] },
    { name: "Linus", active: false, tags: ["dev"] },
    { name: "Grace", active: true, tags: [] },
  ],
  settings: { theme: "dark", fontSize: 14 },
};

function tree(value, indent = 0, key = null) {
  const pad = "  ".repeat(indent), label = key === null ? "" : key + ": ";
  if (Array.isArray(value)) {
    console.log(`${pad}${label}[${value.length} items]`);
    value.forEach((v, i) => tree(v, indent + 1, i));
  } else if (value && typeof value === "object") {
    console.log(`${pad}${label}{${Object.keys(value).length} keys}`);
    for (const [k, v] of Object.entries(value)) tree(v, indent + 1, k);
  } else {
    console.log(`${pad}${label}${JSON.stringify(value)}`);
  }
}

const get = (obj, path, fallback) => path.split(".").reduce((v, key) => (v == null ? v : v[key]), obj) ?? fallback;

tree(data);
console.log("\nusers.0.name        →", get(data, "users.0.name"));
console.log("settings.theme      →", get(data, "settings.theme"));
console.log("users.9.name        →", get(data, "users.9.name", "(nobody)"));
console.log("active users        →", data.users.filter((u) => u.active).map((u) => u.name));
console.log("round trip is equal →", JSON.stringify(JSON.parse(JSON.stringify(data))) === JSON.stringify(data));

