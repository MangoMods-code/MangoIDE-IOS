  hexColor: /^#([0-9a-f]{3}|[0-9a-f]{6})$/i,
  strongPassword: /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/,
};
for (const [value, rule] of [["ada_99", "username"], ["9lives", "username"], ["#ff9a1a", "hexColor"], ["Passw0rdOK", "strongPassword"], ["weak", "strongPassword"]]) {
  console.log(`${value.padEnd(11)} ${rule.padEnd(15)} ${checks[rule].test(value) ? "✅" : "❌"}`);
}
