=== higher-order | Functions as Values | Learn JavaScript | function | Compose, curry, debounce and memoize: functions that take and return functions.
--- main.js
// Functions are values: store them, pass them, return them.
const compose = (...fns) => (input) => fns.reduceRight((value, fn) => fn(value), input);
const pipe = (...fns) => (input) => fns.reduce((value, fn) => fn(value), input);

const trim = (s) => s.trim();
const lower = (s) => s.toLowerCase();
const dashes = (s) => s.replace(/\s+/g, "-");
const slug = pipe(trim, lower, dashes);
console.log("pipe:", slug("  Hello Big World  "), "| compose:", compose(dashes, lower, trim)("  Same Result  "));

// Currying: give arguments one at a time.
const curry = (fn) => function curried(...args) {
  return args.length >= fn.length ? fn(...args) : (...more) => curried(...args, ...more);
};
const volume = curry((l, w, h) => l * w * h);
console.log("curry:", volume(2)(3)(4), volume(2, 3)(4), volume(2)(3, 4));

// Partial application: fix some arguments now.
const greet = (greeting, name) => `${greeting}, ${name}!`;
const hello = greet.bind(null, "Hello");
console.log("partial:", hello("Ada"), hello("Bob"));

// Memoize: remember answers to expensive questions.
const memoize = (fn) => { const cache = new Map(); return (n) => cache.has(n) ? cache.get(n) : (cache.set(n, fn(n)), cache.get(n)); };
let calls = 0;
const slowSquare = (n) => { calls++; return n * n; };
const fastSquare = memoize(slowSquare);
[4, 4, 4, 5].forEach(fastSquare);
console.log("memoize: 4 requests,", calls, "real calculations");

// Debounce: wait for a pause before acting (think search-as-you-type).
const debounce = (fn, ms) => { let timer; return (...args) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), ms); }; };
const search = debounce((query) => console.log(`debounce: searching for "${query}" once, after typing stopped`), 300);
["m", "ma", "man", "mango"].forEach(search);

// Your own array helper built from a callback.
const groupBy = (list, keyOf) => list.reduce((groups, item) => { (groups[keyOf(item)] = groups[keyOf(item)] || []).push(item); return groups; }, {});
console.log("groupBy:", groupBy(["apple", "fig", "kiwi", "plum", "pear"], (w) => w.length));

=== event-emitter | Events & State Machine | Learn JavaScript | antenna.radiowaves.left.and.right | Build an event system, then a traffic light that can only change in legal ways.
--- main.js
// Events let parts of a program talk without knowing about each other.
class Emitter {
  #listeners = new Map();
  on(event, fn) { this.#listeners.set(event, [...(this.#listeners.get(event) || []), fn]); return () => this.off(event, fn); }
  off(event, fn) { this.#listeners.set(event, (this.#listeners.get(event) || []).filter((f) => f !== fn)); }
  once(event, fn) { const stop = this.on(event, (...args) => { stop(); fn(...args); }); }
  emit(event, ...args) { (this.#listeners.get(event) || []).forEach((fn) => fn(...args)); }
}

const shop = new Emitter();
const stopLogging = shop.on("sale", (item, price) => console.log(`  log: sold ${item} for $${price}`));
let revenue = 0;
shop.on("sale", (_, price) => { revenue += price; });
shop.once("sale", () => console.log("  🎉 first sale of the day!"));
shop.emit("sale", "mango", 2);
shop.emit("sale", "blender", 49);
stopLogging();
shop.emit("sale", "lime", 1);
console.log("Revenue:", revenue, "(the last sale wasn't logged: that listener was removed)\n");

// A state machine: a list of states and which moves are allowed between them.
class Machine extends Emitter {
  constructor(start, transitions) { super(); this.state = start; this.transitions = transitions; }
  send(action) {
    const next = this.transitions[this.state]?.[action];
    if (!next) { console.log(`  ✗ can't "${action}" while ${this.state}`); return; }
    const from = this.state;
    this.state = next;
    this.emit("change", from, next);
  }
}
const light = new Machine("red", {
  red: { next: "green" },
  green: { next: "yellow", emergency: "red" },
  yellow: { next: "red" },
});
light.on("change", (from, to) => console.log(`  ${from} → ${to}`));
for (const action of ["next", "next", "emergency", "next", "next", "emergency"]) light.send(action);
console.log("Light ends on:", light.state);
